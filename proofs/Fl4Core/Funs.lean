  (t : obj.Tcb) :
  Result S
  := do
  let st ← obj.Ntfn.state machineStoreInst n_ptr s
  let q ← notification.get_queue machineStoreInst s n_ptr
  let (q1, s1) ← tcbqueue.remove machineStoreInst s tcbqueue.Link.Ep q t
  let (q2, s2) ←
    tcbqueue.append_by_prio machineStoreInst s1 tcbqueue.Link.Ep q1 t
  notification.set_queue machineStoreInst s2 n_ptr q2 st

/-- [fl4_core::notification::receive_signal]:
    Source: 'crates/fl4-core/src/notification.rs', lines 117:0-140:1
    Visibility: public -/
def notification.receive_signal
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) (t : obj.Tcb)
  (n_ptr : Std.U64) (blocking : Bool) :
  Result (S × A)
  := do
  let st ← obj.Ntfn.state machineStoreInst n_ptr s
  if st = obj.NTFN_IDLE
  then
    if blocking
    then
      let s1 ←
        obj.Tcb.set_state machineStoreInst t s sched.TS_BLOCKED_ON_NTFN
      let s2 ← obj.Tcb.set_block_obj machineStoreInst t s1 n_ptr
      let s3 ← sched.schedule_tcb machineStoreInst s2 t
      let s4 ← notification.ntfn_append machineStoreInst s3 n_ptr t
      let s5 ←
        notification.maybe_return_sched_context machineStoreInst s4 n_ptr t
      ok (s5, a)
    else
      let s1 ← obj.Tcb.set_reg machineStoreInst t s layout.reg.BADGE 0#u64
      ok (s1, a)
  else
    if st = obj.NTFN_WAITING
    then
      if blocking
      then
        let s1 ←
          obj.Tcb.set_state machineStoreInst t s sched.TS_BLOCKED_ON_NTFN
        let s2 ← obj.Tcb.set_block_obj machineStoreInst t s1 n_ptr
        let s3 ← sched.schedule_tcb machineStoreInst s2 t
        let s4 ← notification.ntfn_append machineStoreInst s3 n_ptr t
        let s5 ←
          notification.maybe_return_sched_context machineStoreInst s4 n_ptr t
        ok (s5, a)
      else
        let s1 ← obj.Tcb.set_reg machineStoreInst t s layout.reg.BADGE 0#u64
        ok (s1, a)
    else
      let b ← obj.Ntfn.badge machineStoreInst n_ptr s
      let s1 ← obj.Tcb.set_reg machineStoreInst t s layout.reg.BADGE b
      let s2 ← obj.Ntfn.set_state machineStoreInst n_ptr s1 obj.NTFN_IDLE
      let (s3, a1) ←
        notification.maybe_donate_sched_context machineStoreInst
          machineArchInst s2 a t n_ptr
      let i ← obj.Tcb.sc machineStoreInst t s3
      let s4 ← sched.cur_sc machineStoreInst s3
      let b1 ←
        core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc i
          s4
      if b1
      then
        let b2 ← sporadic.sc_sporadic machineStoreInst s3 i
        if b2
        then
          let s5 ← sporadic.unblock_check machineStoreInst s3 i
          ok (s5, a1)
        else ok (s3, a1)
      else ok (s3, a1)

