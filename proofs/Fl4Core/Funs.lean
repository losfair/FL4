  (machineArchInst : machine.Arch A) (s : S) (a : A) (receiver : obj.Tcb)
  (sender : obj.Tcb) :
  Result (Bool × S × A)
  := do
  let tag ← msg.msg_info machineStoreInst s sender
  let ty ← obj.Tcb.fault_type machineStoreInst receiver s
  if ty = fl4_abi.consts.fault.CapFault
  then ok (true, s, a)
  else
    if ty = fl4_abi.consts.fault.UnknownSyscall
    then
      let s1 ← lift (Array.to_slice faults.SYSCALL_MESSAGE)
      let s2 ←
        faults.copy_mrs_fault_reply machineStoreInst s sender receiver s1
          tag.length
      ok (tag.label = 0#u64, s2, a)
    else
      if ty = fl4_abi.consts.fault.UserException
      then
        let s1 ← lift (Array.to_slice faults.EXCEPTION_MESSAGE)
        let s2 ←
          faults.copy_mrs_fault_reply machineStoreInst s sender receiver s1
            tag.length
        ok (tag.label = 0#u64, s2, a)
      else
        if ty = fl4_abi.consts.fault.Timeout
        then
          let s1 ← lift (Array.to_slice faults.TIMEOUT_REPLY_MESSAGE)
          let s2 ←
            faults.copy_mrs_fault_reply machineStoreInst s sender receiver s1
              tag.length
          ok (tag.label = 0#u64, s2, a)
        else
          if ty = fl4_abi.consts.fault.DebugException
          then
            let i ← obj.Tcb.fault_w0 machineStoreInst receiver s
            if i != debug.SINGLE_STEP
            then ok (tag.label = 0#u64, s, a)
            else
              let n_instrs ←
                if tag.length < 1#u64
                then ok 1#u64
                else
                  do
                  let i1 ← msg.msg_register 0#u64
                  obj.Tcb.reg machineStoreInst sender s i1
              let (_, s1, a1) ←
                debug.configure_single_stepping machineStoreInst
                  machineArchInst s a receiver 0#u64 n_instrs true
              ok (tag.label = 0#u64, s1, a1)
          else ok (true, s, a)

