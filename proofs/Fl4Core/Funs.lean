    Source: 'crates/fl4-core/src/sporadic.rs', lines 40:0-50:1
    Visibility: public -/
def sporadic.refill_absolute_max (size_bits : Std.U64) : Result Std.U64 := do
  if size_bits >= 64#u64
  then ok 0#u64
  else
    let i ← lift (size_bits &&& 63#u64)
    let bytes ← 1#u64 <<< i
    if bytes < layout.sc.REFILLS
    then ok 0#u64
    else let i1 ← bytes - layout.sc.REFILLS
         i1 / layout.sc.REFILL_SIZE

