    Source: 'crates/fl4-core/src/syscall.rs', lines 261:0-272:1 -/
def syscall.mcs_preemption_point
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) :
  Result (S × A)
  := do
  let ct ← sched.cur_thread machineStoreInst s
  let b ← sched.is_schedulable machineStoreInst s ct
  if b
  then
    let (_, s1, a1) ← sched.check_budget machineStoreInst machineArchInst s a
    ok (s1, a1)
  else
    let s1 ← sched.cur_sc machineStoreInst s
    let b1 ← sporadic.sc_active machineStoreInst s s1
    if b1
    then
      let c ← sched.consumed machineStoreInst s
      sched.charge_budget machineStoreInst machineArchInst s a c false
    else
      let cpu ← machineStoreInst.cur_cpu s
      let s2 ← obj.node_set machineStoreInst s cpu layout.node.CONSUMED 0#u64
      ok (s2, a)

/-- [fl4_core::syscall::handle_yield]:
    Source: 'crates/fl4-core/src/syscall.rs', lines 274:0-280:1 -/
def syscall.handle_yield
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) :
  Result (S × A)
  := do
  let csc ← sched.cur_sc machineStoreInst s
  let i ← obj.Sc.consumed machineStoreInst csc s
  let i1 ← sched.consumed machineStoreInst s
  let total ← lift (core.num.U64.wrapping_add i i1)
  let head ← sporadic.head machineStoreInst s csc
  let (s1, a1) ←
    sched.charge_budget machineStoreInst machineArchInst s a head.amount false
  let s2 ← obj.Sc.set_consumed machineStoreInst csc s1 total
  ok (s2, a1)

