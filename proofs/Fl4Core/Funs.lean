def sporadic.refill_update
  {S : Type _} (machineStoreInst : machine.Store S) (s : S) (sc : obj.Sc)
  (new_period : Std.U64) (new_budget : Std.U64) (new_max_refills : Std.U64) :
  Result S
  := do
  let h ← sporadic.head machineStoreInst s sc
  let s1 ← sporadic.put machineStoreInst s sc 0#u64 h
  let s2 ← obj.Sc.set_refill_head machineStoreInst sc s1 0#u64
  let s3 ← obj.Sc.set_refill_tail machineStoreInst sc s2 0#u64
  let s4 ← obj.Sc.set_refill_max machineStoreInst sc s3 new_max_refills
  let s5 ← obj.Sc.set_period machineStoreInst sc s4 new_period
  let b ← sporadic.ready machineStoreInst s5 sc
  let s6 ←
    if b
    then
      do
      let now ← sporadic.cur_time machineStoreInst s5
      let r ← sporadic.head machineStoreInst s5 sc
      sporadic.set_head machineStoreInst s5 sc { r with time := now }
    else ok s5
  let hd ← sporadic.head machineStoreInst s6 sc
  if hd.amount >= new_budget
  then
    let s7 ←
      sporadic.set_head machineStoreInst s6 sc { hd with amount := new_budget }
    sporadic.maybe_add_empty_tail machineStoreInst s7 sc
  else
    let i ← lift (core.num.U64.wrapping_add hd.time new_period)
    let i1 ← new_budget - hd.amount
    sporadic.add_tail machineStoreInst s6 sc { time := i, amount := i1 }

