  let s3 ← obj.Tcb.set_fault_w0 machineStoreInst t s2 w0
  let s4 ← obj.Tcb.set_fault_w1 machineStoreInst t s3 w1
  obj.Tcb.set_fault_w2 machineStoreInst t s4 w2

