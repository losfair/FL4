    let s1 ← ioport.apply machineStoreInst s lw i set
    let w ← lw + 1#u64
    let s2 ← ioport.set_mask_loop machineStoreInst s1 set hw w
    let i1 ← lift (core.num.U64.wrapping_add hi 1#u64)
