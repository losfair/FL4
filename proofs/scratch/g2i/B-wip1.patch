+/-- The spec's idle thread is the idle word at an `XTopAt` state. -/
+theorem _root_.Fl4Proofs.P3.XTopAt.idleThread_bv {Z' : XSets} {s' : S} {a' : A} {σ' : Fl4Spec.State Unit}
