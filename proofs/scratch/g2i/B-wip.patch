+    (by obtain ⟨Tr, Cq, hJ⟩ := J.jpl
+        exact Set.ext fun t => ⟨fun h => J.zH.1 t h, fun h => J.thT t ((hJ.tcb t).2 h)⟩)
+    hX hth hT hc hSS hK horig hidl hdead
