def sched.charge_budget
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) (used : Std.U64)
  (can_timeout_fault : Bool) :
  Result (S × A)
  := do
  let sc ← sched.cur_sc machineStoreInst s
  let s1 ← sched.idle_sc machineStoreInst s
  let b ←
    core.cmp.PartialEq.ne.trait_default obj.Sc.Insts.CoreCmpPartialEqSc sc s1
  let s2 ←
    if b
    then
      do
      let b1 ← sporadic.is_round_robin machineStoreInst s sc
      let s3 ←
        if b1
        then
          do
          let hi ← obj.Sc.refill_head machineStoreInst sc s
          let ti ← obj.Sc.refill_tail machineStoreInst sc s
          let h ← sporadic.get machineStoreInst s sc hi
          let t ← sporadic.get machineStoreInst s sc ti
          let i ← lift (core.num.U64.wrapping_add h.amount t.amount)
          let s4 ←
            sporadic.put machineStoreInst s sc hi { h with amount := i }
          sporadic.put machineStoreInst s4 sc ti { t with amount := 0#u64 }
        else sporadic.budget_check machineStoreInst machineArchInst s a used
      let i ← obj.Sc.consumed machineStoreInst sc s3
      let total ← lift (core.num.U64.wrapping_add i used)
      obj.Sc.set_consumed machineStoreInst sc s3 total
    else ok s
  let s3 ← sched.set_consumed machineStoreInst s2 0#u64
  let ct ← sched.cur_thread machineStoreInst s3
  let b1 ← sched.is_schedulable machineStoreInst s3 ct
  if b1
  then
    let (s4, a1) ←
      sched.end_timeslice machineStoreInst machineArchInst s3 a
        can_timeout_fault
    let s5 ← sched.reschedule_required machineStoreInst s4
    let s6 ← sched.set_reprogram machineStoreInst s5
    ok (s6, a1)
  else ok (s3, a)

