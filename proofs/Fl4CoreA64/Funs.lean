def ipc.do_reply_transfer
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) (sender : obj.Tcb)
  (r : obj.Reply) (grant : Bool) :
  Result (S × A)
  := do
  let i ← obj.Reply.tcb machineStoreInst r s
  let b ← obj.Tcb.is_null i
  if b
  then ok (s, a)
  else
    let i1 ← obj.Tcb.state machineStoreInst i s
    if i1 != sched.TS_BLOCKED_ON_REPLY
    then ok (s, a)
    else
      let (s1, a1) ←
        ipc.reply_remove machineStoreInst machineArchInst s a r i
      let i2 ← obj.Tcb.sc machineStoreInst i s1
      let b1 ← sporadic.sc_sporadic machineStoreInst s1 i2
      let s2 ←
        if b1
        then
          do
          let i3 ← obj.Sc.cpu machineStoreInst i2 s1
          let i4 ← obj.node_get machineStoreInst s1 i3 layout.node.CUR_SC
          if i2 != i4
          then sporadic.unblock_check machineStoreInst s1 i2
          else ok s1
        else ok s1
      let fault_type ← obj.Tcb.fault_type machineStoreInst i s2
      let (s3, a2) ←
        if fault_type = fl4_abi.consts.fault.NullFault
        then
          do
          let s4 ←
            ipc.do_ipc_transfer machineStoreInst machineArchInst s2 a1 sender
              0#u64 0#u64 grant i
          let s5 ←
            sched.set_thread_state machineStoreInst s4 i sched.TS_RUNNING
          ok (s5, a1)
        else
          do
          let (restart, s4, a3) ←
            faults.handle_fault_reply machineStoreInst machineArchInst s2 a1 i
              sender
          let s5 ← faults.clear_fault machineStoreInst s4 i
          if restart
          then
            let s6 ←
              sched.set_thread_state machineStoreInst s5 i sched.TS_RESTART
            ok (s6, a3)
          else
            let s6 ←
              sched.set_thread_state machineStoreInst s5 i sched.TS_INACTIVE
            ok (s6, a3)
      let i3 ← obj.Tcb.sc machineStoreInst i s3
      let b2 ← obj.Sc.is_null i3
      if b2
      then ok (s3, a2)
      else
        let b3 ← sched.is_runnable machineStoreInst s3 i
        if b3
        then
          let b4 ← sporadic.ready machineStoreInst s3 i3
          if b4
          then
            let b5 ←
              sporadic.sufficient machineStoreInst machineArchInst s3 a2 i3
                0#u64
            if b5
            then
              let s4 ← sched.possible_switch_to machineStoreInst s3 i
              ok (s4, a2)
            else
              let b6 ← faults.valid_timeout_handler machineStoreInst s3 i
              if b6
              then
                if fault_type != fl4_abi.consts.fault.Timeout
                then
                  let badge ← obj.Sc.badge machineStoreInst i3 s3
                  faults.handle_timeout machineStoreInst machineArchInst s3 a2
                    i (error.Fault.Timeout badge)
                else
                  let s4 ← sched.postpone machineStoreInst s3 i3
                  ok (s4, a2)
              else let s4 ← sched.postpone machineStoreInst s3 i3
                   ok (s4, a2)
          else
            let b5 ← faults.valid_timeout_handler machineStoreInst s3 i
            if b5
            then
              if fault_type != fl4_abi.consts.fault.Timeout
              then
                let badge ← obj.Sc.badge machineStoreInst i3 s3
                faults.handle_timeout machineStoreInst machineArchInst s3 a2 i
                  (error.Fault.Timeout badge)
              else let s4 ← sched.postpone machineStoreInst s3 i3
                   ok (s4, a2)
            else let s4 ← sched.postpone machineStoreInst s3 i3
                 ok (s4, a2)
        else ok (s3, a2)

