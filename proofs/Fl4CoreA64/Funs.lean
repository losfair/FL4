    | capability.Cap.AsidPool _ _ => ok true
    | capability.Cap.IoPortControl => ok true
    | capability.Cap.IoPort _ _ _ => ok true
  | capability.Cap.Reply _ _ => ok false
  | capability.Cap.CNode _ _ _ _ => ok false
