  then
    if rr
    then
      let b ← sporadic.ready machineStoreInst s sc
      if b
      then
        let b1 ←
          sporadic.sufficient machineStoreInst machineArchInst s a sc 0#u64
        if b1
        then let s1 ← sched.append machineStoreInst s ct
             ok (s1, a)
        else let s1 ← sched.postpone machineStoreInst s sc
             ok (s1, a)
      else let s1 ← sched.postpone machineStoreInst s sc
           ok (s1, a)
    else
      if valid
      then
        let badge ← obj.Sc.badge machineStoreInst sc s
        faults.handle_timeout machineStoreInst machineArchInst s a ct
          (error.Fault.Timeout badge)
      else
        let b ← sporadic.ready machineStoreInst s sc
        if b
        then
          let b1 ←
            sporadic.sufficient machineStoreInst machineArchInst s a sc 0#u64
          if b1
          then let s1 ← sched.append machineStoreInst s ct
               ok (s1, a)
          else let s1 ← sched.postpone machineStoreInst s sc
               ok (s1, a)
        else let s1 ← sched.postpone machineStoreInst s sc
             ok (s1, a)
  else
    let b ← sporadic.ready machineStoreInst s sc
    if b
    then
      let b1 ←
        sporadic.sufficient machineStoreInst machineArchInst s a sc 0#u64
      if b1
      then let s1 ← sched.append machineStoreInst s ct
           ok (s1, a)
      else let s1 ← sched.postpone machineStoreInst s sc
           ok (s1, a)
    else let s1 ← sched.postpone machineStoreInst s sc
         ok (s1, a)

