def faults.set_mrs_fault
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) (sender : obj.Tcb)
  (receiver : obj.Tcb) (buf : Std.U64) :
  Result (Std.U64 × S)
  := do
  let ty ← obj.Tcb.fault_type machineStoreInst sender s
  let w0 ← obj.Tcb.fault_w0 machineStoreInst sender s
  let w1 ← obj.Tcb.fault_w1 machineStoreInst sender s
  let w2 ← obj.Tcb.fault_w2 machineStoreInst sender s
