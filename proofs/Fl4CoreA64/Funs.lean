      let s3 ←
        if i != 0#u64
        then ipc.reply_unlink machineStoreInst s2 i q.head
        else ok s2
      let (s4, a1) ←
        if do_call
        then
          if i != 0#u64
          then
            if can_grant
            then
              ipc.reply_push machineStoreInst machineArchInst s3 a thread
                q.head i can_donate
            else
              if can_grant_reply
              then
                ipc.reply_push machineStoreInst machineArchInst s3 a thread
                  q.head i can_donate
              else
                do
                let s5 ←
                  sched.set_thread_state machineStoreInst s3 thread
                    sched.TS_INACTIVE
                ok (s5, a)
          else
            do
            let s5 ←
              sched.set_thread_state machineStoreInst s3 thread
                sched.TS_INACTIVE
            ok (s5, a)
        else
          do
          let i1 ← obj.Tcb.fault_type machineStoreInst thread s3
          if i1 != fl4_abi.consts.fault.NullFault
          then
            if i != 0#u64
            then
              if can_grant
              then
                ipc.reply_push machineStoreInst machineArchInst s3 a thread
                  q.head i can_donate
              else
                if can_grant_reply
                then
                  ipc.reply_push machineStoreInst machineArchInst s3 a thread
                    q.head i can_donate
                else
                  let s5 ←
                    sched.set_thread_state machineStoreInst s3 thread
                      sched.TS_INACTIVE
                  ok (s5, a)
            else
              let s5 ←
                sched.set_thread_state machineStoreInst s3 thread
                  sched.TS_INACTIVE
              ok (s5, a)
          else
            if can_donate
            then
              let i2 ← obj.Tcb.sc machineStoreInst q.head s3
              if i2 = 0#u64
              then
                let i3 ← obj.Tcb.sc machineStoreInst thread s3
                schedcontext.donate machineStoreInst machineArchInst s3 a i3
                  q.head
              else ok (s3, a)
            else ok (s3, a)
      let s5 ←
        sched.set_thread_state machineStoreInst s4 q.head sched.TS_RUNNING
      let s6 ← endpoint.unblock_sporadic machineStoreInst s5 q.head
      let s7 ← sched.possible_switch_to machineStoreInst s6 q.head
      ok (s7, a1)

