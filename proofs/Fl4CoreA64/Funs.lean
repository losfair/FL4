def objects.is_frame_type (t : Std.U64) : Result Bool := do
  if t = fl4_abi.consts.object.ArmSmallPage
  then ok true
  else
    if t = fl4_abi.consts.object.ArmLargePage
    then ok true
    else ok (t = fl4_abi.consts.object.ArmHugePage)

