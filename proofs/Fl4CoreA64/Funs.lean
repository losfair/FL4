def syscall.decode_invocation
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) (lbl : Std.U64)
  (length : Std.U64) (slot : obj.Slot) (cap : capability.Cap) (block : Bool)
  (call : Bool) (can_donate : Bool) (first_phase : Bool) (buf : Std.U64)
  (extra : Array obj.Slot 3#usize) :
  Result ((core.result.Result Unit error.Exc) × S × A)
  := do
  let ct ← sched.cur_thread machineStoreInst s
  match cap with
  | capability.Cap.Null =>
    ok (core.result.Result.Err (error.Exc.Sys (error.SysError.InvalidCapability
      0#u64)), s, a)
  | capability.Cap.Untyped _ _ _ _ =>
    untyped.decode machineStoreInst machineArchInst s a lbl length slot cap buf
      extra
  | capability.Cap.Endpoint ptr badge send _ grant grant_reply =>
    if send
    then
      let s1 ← sched.set_thread_state machineStoreInst s ct sched.TS_RESTART
      let (s2, a1) ←
        endpoint.send_ipc machineStoreInst machineArchInst s1 a block call
          badge grant grant_reply can_donate ct ptr
      ok (core.result.Result.Ok (), s2, a1)
    else
      ok (core.result.Result.Err (error.Exc.Sys
        (error.SysError.InvalidCapability 0#u64)), s, a)
  | capability.Cap.Notification ptr badge send _ =>
    if send
    then
      let s1 ← sched.set_thread_state machineStoreInst s ct sched.TS_RESTART
      let (s2, a1) ←
        notification.send_signal machineStoreInst machineArchInst s1 a ptr
          badge
      ok (core.result.Result.Ok (), s2, a1)
    else
      ok (core.result.Result.Err (error.Exc.Sys
        (error.SysError.InvalidCapability 0#u64)), s, a)
  | capability.Cap.Reply ptr grant =>
    let s1 ← sched.set_thread_state machineStoreInst s ct sched.TS_RESTART
    let (s2, a1) ←
      ipc.do_reply_transfer machineStoreInst machineArchInst s1 a ct ptr grant
    ok (core.result.Result.Ok (), s2, a1)
  | capability.Cap.CNode _ _ _ _ =>
    if first_phase
    then
      ok (core.result.Result.Err (error.Exc.Sys
        (error.SysError.InvalidCapability 0#u64)), s, a)
    else
      cnode.decode machineStoreInst machineArchInst s a lbl length cap buf
        extra
  | capability.Cap.Thread ptr =>
    if first_phase
    then
      ok (core.result.Result.Err (error.Exc.Sys
        (error.SysError.InvalidCapability 0#u64)), s, a)
    else
      tcb.decode machineStoreInst machineArchInst s a lbl ptr
        { length, buf, call, slot, extra }
  | capability.Cap.IrqControl =>
    interrupt.decode_irq_control machineStoreInst machineArchInst s a lbl
      length slot buf extra
  | capability.Cap.IrqHandler irq =>
    interrupt.decode_irq_handler machineStoreInst machineArchInst s a lbl irq
      extra
  | capability.Cap.Zombie _ _ _ =>
    ok (core.result.Result.Err (error.Exc.Sys (error.SysError.InvalidCapability
      0#u64)), s, a)
  | capability.Cap.Domain =>
    if first_phase
    then
      ok (core.result.Result.Err (error.Exc.Sys
        (error.SysError.InvalidCapability 0#u64)), s, a)
    else
      domain.decode machineStoreInst machineArchInst s a lbl length buf extra
  | capability.Cap.SchedContext ptr _ =>
    if first_phase
    then
      ok (core.result.Result.Err (error.Exc.Sys
        (error.SysError.InvalidCapability 0#u64)), s, a)
    else
      schedcontext.decode machineStoreInst machineArchInst s a lbl ptr call
        extra
  | capability.Cap.SchedControl cpu =>
    if first_phase
    then
      ok (core.result.Result.Err (error.Exc.Sys
        (error.SysError.InvalidCapability 0#u64)), s, a)
    else
      schedcontext.decode_sched_control machineStoreInst machineArchInst s a
        lbl cpu length buf extra
  | capability.Cap.Frame _ _ _ _ _ _ _ _ =>
    vspace.decode machineStoreInst machineArchInst s a lbl length slot cap call
      buf extra
  | capability.Cap.PageTable _ _ _ _ =>
    vspace.decode machineStoreInst machineArchInst s a lbl length slot cap call
      buf extra
  | capability.Cap.PageDirectory _ _ _ _ =>
    vspace.decode machineStoreInst machineArchInst s a lbl length slot cap call
      buf extra
  | capability.Cap.Pdpt _ _ _ _ =>
    vspace.decode machineStoreInst machineArchInst s a lbl length slot cap call
      buf extra
  | capability.Cap.Pml4 _ _ _ =>
    vspace.decode machineStoreInst machineArchInst s a lbl length slot cap call
      buf extra
  | capability.Cap.Vcpu ptr =>
    vcpu.decode machineStoreInst machineArchInst s a lbl length ptr call buf
      extra
  | capability.Cap.Ept _ _ _ _ _ =>
    ept.decode machineStoreInst machineArchInst s a lbl length cap slot buf
      extra
  | capability.Cap.AsidControl =>
    vspace.decode machineStoreInst machineArchInst s a lbl length slot
      capability.Cap.AsidControl call buf extra
  | capability.Cap.AsidPool _ _ =>
    vspace.decode machineStoreInst machineArchInst s a lbl length slot cap call
      buf extra
  | capability.Cap.IoPortControl =>
    ioport.decode_control machineStoreInst machineArchInst s a lbl length slot
      buf extra
  | capability.Cap.IoPort _ _ _ =>
    ioport.decode machineStoreInst machineArchInst s a lbl length cap call buf

