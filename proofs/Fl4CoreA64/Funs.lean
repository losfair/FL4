  (high : Std.U64) :
  Result Bool
  := do
  let lw ← low >>> 6#i32
  let hw ← high >>> 6#i32
  let li ← lift (low &&& 63#u64)
  let hi ← lift (high &&& 63#u64)
  if lw = hw
  then
    let i ← ioport.word_off lw
    let i1 ← obj.ks_get machineStoreInst s i
    let i2 ← lift (core.num.U64.wrapping_add hi 1#u64)
    let i3 ← ioport.pattern li i2
    let i4 ← lift (i1 &&& i3)
    ok (i4 = 0#u64)
  else
    let i ← ioport.word_off lw
    let i1 ← obj.ks_get machineStoreInst s i
    let i2 ← ioport.pattern li 64#u64
    let i3 ← lift (i1 &&& i2)
    if i3 != 0#u64
    then ok false
