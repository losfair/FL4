        | capability.Cap.PageDirectory _ _ _ _ => ok none
        | capability.Cap.Pdpt _ _ _ _ => ok none
        | capability.Cap.Pml4 _ _ _ => ok none
        | capability.Cap.Vcpu _ => ok none
        | capability.Cap.Ept _ _ _ _ _ => ok none
