  if ty = fl4_abi.consts.fault.CapFault
  then
    let (_, s1) ← msg.set_mr machineStoreInst s receiver buf 0#u64 restart_pc
    let (_, s2) ← msg.set_mr machineStoreInst s1 receiver buf 1#u64 w0
    let (_, s3) ← msg.set_mr machineStoreInst s2 receiver buf 2#u64 w1
