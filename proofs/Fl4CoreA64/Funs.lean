    match src with
    | capability.Cap.Null => ok true
    | capability.Cap.Untyped _ _ _ _ => ok true
    | capability.Cap.Endpoint _ _ _ _ _ _ => ok true
    | capability.Cap.Notification _ b _ _ => ok (badge != b)
