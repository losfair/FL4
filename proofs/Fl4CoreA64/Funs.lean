def vspace.page_cache_op (lbl : Std.U64) : Result Std.U64 := do
  if lbl = fl4_abi.label.ARMPageClean_Data
  then ok vspace.CACHE_CLEAN
  else
    if lbl = fl4_abi.label.ARMVSpaceClean_Data
    then ok vspace.CACHE_CLEAN
    else
      if lbl = fl4_abi.label.ARMPageInvalidate_Data
      then ok vspace.CACHE_INVALIDATE
      else
        if lbl = fl4_abi.label.ARMVSpaceInvalidate_Data
        then ok vspace.CACHE_INVALIDATE
        else
          if lbl = fl4_abi.label.ARMPageCleanInvalidate_Data
          then ok vspace.CACHE_CLEAN_INVALIDATE
          else
            if lbl = fl4_abi.label.ARMVSpaceCleanInvalidate_Data
            then ok vspace.CACHE_CLEAN_INVALIDATE
            else ok vspace.CACHE_UNIFY

