        endpoint.ep_append machineStoreInst s5 ep_ptr thread obj.EP_SEND
      ok (s6, a)
    else ok (s, a)
  else
    if st = obj.EP_SEND
    then
      if blocking
      then
        let s1 ←
          obj.Tcb.set_state machineStoreInst thread s sched.TS_BLOCKED_ON_SEND
        let s2 ← obj.Tcb.set_block_obj machineStoreInst thread s1 ep_ptr
        let s3 ← obj.Tcb.set_block_badge machineStoreInst thread s2 badge
        let i ← if can_grant
                  then ok endpoint.FLAG_GRANT
                  else ok 0#u64
        let i1 ←
          if can_grant_reply
          then ok endpoint.FLAG_GRANT_REPLY
          else ok 0#u64
        let i2 ← lift (i ||| i1)
        let i3 ← if do_call
                   then ok endpoint.FLAG_CALL
                   else ok 0#u64
        let f ← lift (i2 ||| i3)
        let s4 ← obj.Tcb.set_block_flags machineStoreInst thread s3 f
        let s5 ← sched.schedule_tcb machineStoreInst s4 thread
        let s6 ←
          endpoint.ep_append machineStoreInst s5 ep_ptr thread obj.EP_SEND
        ok (s6, a)
      else ok (s, a)
