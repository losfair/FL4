    faults.set_mrs_lookup_failure machineStoreInst s3 receiver buf lf 3#u64
  else
    if ty = fl4_abi.consts.fault.UnknownSyscall
    then
      let s1 ← lift (Array.to_slice faults.SYSCALL_MESSAGE)
      let s2 ←
        faults.copy_mrs_fault machineStoreInst s sender receiver s1 buf
      msg.set_mr machineStoreInst s2 receiver buf 12#u64 w0
    else
      if ty = fl4_abi.consts.fault.UserException
      then
        let s1 ← lift (Array.to_slice faults.EXCEPTION_MESSAGE)
        let s2 ←
          faults.copy_mrs_fault machineStoreInst s sender receiver s1 buf
        let (_, s3) ← msg.set_mr machineStoreInst s2 receiver buf 3#u64 w0
        msg.set_mr machineStoreInst s3 receiver buf 4#u64 w1
      else
        if ty = fl4_abi.consts.fault.Timeout
        then
          let i ← obj.Tcb.sc machineStoreInst sender s
          let b ← obj.Sc.is_null i
          if b
          then msg.set_mr machineStoreInst s receiver buf 0#u64 w0
          else
            let (consumed, s1) ←
              schedcontext.update_consumed machineStoreInst machineArchInst s a
                i
            let (len, s2) ←
              msg.set_mr machineStoreInst s1 receiver buf 0#u64 w0
            msg.set_mr machineStoreInst s2 receiver buf len consumed
        else
          if ty = fl4_abi.consts.fault.DebugException
          then
            let (_, s1) ←
              msg.set_mr machineStoreInst s receiver buf 0#u64 restart_pc
            let (ret, s2) ←
              msg.set_mr machineStoreInst s1 receiver buf 1#u64 w0
            if w0 != debug.SINGLE_STEP
            then
              if w0 != debug.SOFTWARE_BREAK_REQUEST
              then
                let (_, s3) ←
                  msg.set_mr machineStoreInst s2 receiver buf 2#u64 w1
                msg.set_mr machineStoreInst s3 receiver buf 3#u64 w2
              else ok (ret, s2)
            else ok (ret, s2)
          else
            if ty = fl4_abi.consts.fault.VMFault
            then
              let (_, s1) ←
                msg.set_mr machineStoreInst s receiver buf 0#u64 restart_pc
              let (_, s2) ←
                msg.set_mr machineStoreInst s1 receiver buf 1#u64 w0
              let (_, s3) ←
                msg.set_mr machineStoreInst s2 receiver buf 2#u64 w2
              msg.set_mr machineStoreInst s3 receiver buf 3#u64 w1
            else
              if ty = fl4_abi.consts.fault.VCPUFault
              then msg.set_mr machineStoreInst s receiver buf 0#u64 w0
              else
                if ty = fl4_abi.consts.fault.VGICMaintenance
                then
                  if w1 != 0#u64
                  then msg.set_mr machineStoreInst s receiver buf 0#u64 w0
                  else ok (0#u64, s)
                else
                  if ty = fl4_abi.consts.fault.VPPIEvent
                  then msg.set_mr machineStoreInst s receiver buf 0#u64 w0
                  else ok (0#u64, s)

