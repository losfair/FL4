  (machineArchInst : machine.Arch A) (s : S) (a : A) (blocking : Bool)
  (do_call : Bool) (badge : Std.U64) (can_grant : Bool)
  (can_grant_reply : Bool) (can_donate : Bool) (thread : obj.Tcb)
  (ep_ptr : Std.U64) :
  Result (S × A)
  := do
  let st ← obj.Ep.state machineStoreInst ep_ptr s
  if st = obj.EP_IDLE
  then
    if blocking
    then
      let s1 ←
        obj.Tcb.set_state machineStoreInst thread s sched.TS_BLOCKED_ON_SEND
      let s2 ← obj.Tcb.set_block_obj machineStoreInst thread s1 ep_ptr
      let s3 ← obj.Tcb.set_block_badge machineStoreInst thread s2 badge
