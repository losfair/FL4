def syscall.handle_vm_fault
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) (addr : Std.U64)
  (code : Std.U64) :
  Result (S × A)
  := do
