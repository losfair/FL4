def capability.Rights.from_word (w : Std.U64) : Result capability.Rights := do
  let i ← lift (w &&& 1#u64)
  let i1 ← lift (w &&& 2#u64)
  let i2 ← lift (w &&& 4#u64)
  let i3 ← lift (w &&& 8#u64)
  ok
    {
      write := (i != 0#u64),
      read := (i1 != 0#u64),
      grant := (i2 != 0#u64),
      grant_reply := (i3 != 0#u64)
    }

