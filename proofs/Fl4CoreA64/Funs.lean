def syscall.handle_invocation
  {S : Type _} {A : Type _} (machineStoreInst : machine.Store S)
  (machineArchInst : machine.Arch A) (s : S) (a : A) (is_call : Bool)
  (blocking : Bool) (can_donate : Bool) (first_phase : Bool) (cptr : Std.U64) :
  Result ((core.result.Result Unit error.Exc) × S × A)
  := do
  let t ← sched.cur_thread machineStoreInst s
  let info ← msg.msg_info machineStoreInst s t
  let r ← cspace.lookup_slot machineStoreInst s t cptr
  match r with
  | core.result.Result.Ok r1 =>
    let cap ← obj.Slot.cap machineStoreInst r1.slot s
    let buf ← msg.lookup_ipc_buffer machineStoreInst s false t
    let r2 ← ipc.lookup_extra_caps machineStoreInst s t buf info
    match r2 with
    | core.result.Result.Ok e =>
      let length ←
        if info.length > msg.N_MSG_REGISTERS
        then if buf = 0#u64
             then ok msg.N_MSG_REGISTERS
             else ok info.length
        else ok info.length
      let (r3, s1, a1) ←
        syscall.decode_invocation machineStoreInst machineArchInst s a
          info.label length r1.slot cap blocking is_call can_donate first_phase
          buf e
      match r3 with
      | core.result.Result.Ok _ =>
        let i ← obj.Tcb.state machineStoreInst t s1
        if i = sched.TS_RESTART
        then
          let s2 ←
            if is_call
            then msg.reply_success_empty machineStoreInst s1 t
            else ok s1
          let s3 ←
            sched.set_thread_state machineStoreInst s2 t sched.TS_RUNNING
          ok (core.result.Result.Ok (), s3, a1)
        else ok (core.result.Result.Ok (), s1, a1)
      | core.result.Result.Err e1 =>
        match e1 with
        | error.Exc.Fault _ => ok (core.result.Result.Ok (), s1, a1)
        | error.Exc.Lookup _ => ok (core.result.Result.Ok (), s1, a1)
        | error.Exc.Sys e2 =>
          if is_call
          then
            let s2 ← syscall.reply_error machineStoreInst s1 t e2
            ok (core.result.Result.Ok (), s2, a1)
          else ok (core.result.Result.Ok (), s1, a1)
        | error.Exc.Preempted => ok (r3, s1, a1)
    | core.result.Result.Err f =>
      if blocking
      then
        let (s1, a1) ←
          faults.handle_fault machineStoreInst machineArchInst s a t f
        ok (core.result.Result.Ok (), s1, a1)
      else ok (core.result.Result.Ok (), s, a)
  | core.result.Result.Err lf =>
    if blocking
    then
      let (s1, a1) ←
        faults.handle_fault machineStoreInst machineArchInst s a t
          (error.Fault.Cap cptr false lf)
      ok (core.result.Result.Ok (), s1, a1)
    else ok (core.result.Result.Ok (), s, a)

