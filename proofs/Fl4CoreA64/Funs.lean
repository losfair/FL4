/-- [fl4_core::capability::mask_vm_rights]:
    Source: 'crates/fl4-core/src/capability.rs', lines 289:0-301:1
    Visibility: public -/
def capability.mask_vm_rights
  (vm : Std.U64) (r : capability.Rights) : Result Std.U64 := do
  if vm = capability.VM_READ_ONLY
  then
    if r.read
    then ok capability.VM_READ_ONLY
    else
      if vm = capability.VM_READ_WRITE
      then
        if r.read
        then
          if r.write
          then ok capability.VM_READ_WRITE
          else ok capability.VM_READ_ONLY
        else ok capability.VM_KERNEL_ONLY
      else ok capability.VM_KERNEL_ONLY
  else
    if vm = capability.VM_READ_WRITE
    then
      if r.read
      then
        if r.write
        then ok capability.VM_READ_WRITE
        else ok capability.VM_READ_ONLY
      else ok capability.VM_KERNEL_ONLY
    else ok capability.VM_KERNEL_ONLY

