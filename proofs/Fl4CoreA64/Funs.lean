          let i6 ← obj.node_get machineStoreInst s cpu layout.node.REPROGRAM
          if i6 != 0#u64
          then
            let i7 ←
              obj.node_get machineStoreInst s i layout.node.IPI_PENDING
            let i8 ← lift (cpu &&& 63#u64)
            let i9 ← 1#u64 <<< i8
            let m ← lift (i7 ||| i9)
