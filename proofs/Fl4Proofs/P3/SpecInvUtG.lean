/-- One step of `rec_del`, its recursive calls keeping `UtInv'`; the written
remainder of a non-removable cap is not null and not untyped (`finaliseCap_nu`). -/
theorem ui_recDelF {f : RecDelCall → NonDet (State Unit) (Except Unit (Bool × Cap))}
    (hrec : ∀ k, IK UtInv' (f k)) (k : RecDelCall) : IKE UtInv' (recDelF (Z := Unit) f k) := by
  have hrec' : ∀ k, IKE UtInv' (ε := Unit) (f k : NonDetE (State Unit) Unit (Bool × Cap)) := hrec
  cases k with
  | cTEDeleteCall sl e => unfold recDelF withoutPreemption; ui_auto; all_goals exact hrec' _
  | finaliseSlotCall sl e =>
    unfold recDelF withoutPreemption
    refine ike_bind (ike_liftE (by ui_auto)) fun cap => ?_
    refine ike_ite _ (ike_returnOk _) ?_
    refine ike_bind (ike_liftE (by ui_auto)) fun isFinal => ?_
    refine ike_bind_v (Q := RemNU) (ike_liftE (ui_finaliseCap _ _)) (fun σ x hx a ha => ?_) fun r hr => ?_
    · obtain ⟨y, hy, rfl⟩ := mem_liftE' hx
      simp only at ha
      injection ha with e
      subst e
      exact finaliseCap_nu _ _ σ y hy
    obtain ⟨rem, cl⟩ := r
    dsimp only
    by_cases h1 : capRemoveable rem sl
    · rw [if_pos h1]; exact ike_returnOk _
    · rw [if_neg h1]
      have hnn : NNU rem := And.intro (fun e => h1 (by subst e; trivial)) hr
      ui_auto
      all_goals exact hrec' _
  | reduceZombieCall c sl e =>
    unfold recDelF withoutPreemption
    split <;> ui_auto
    all_goals exact hrec' _

theorem ui_recDel (c : RecDelCall) : IKE UtInv' (recDel (Z := Unit) c) := by
  unfold recDel
  exact ik_lfp (fun f hf k => ui_recDelF hf k) c
macro_rules | `(tactic| ui_leaf) => `(tactic| with_reducible exact ui_recDel _)

