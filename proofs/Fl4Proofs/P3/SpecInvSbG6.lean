/- sb1: the SIK family (ScInv kept), part 6 (generated by proofs/scratch/sb1/mksi.sh, then written by hand, cases first (sb2): the TCB frame install, the CNode invocations, the IRQ handler invocations, the interrupt and preemption paths). -/
import Fl4Proofs.P3.SpecInvSbG5
open Classical

namespace Fl4Proofs.P3.SInvB
open Fl4Spec Fl4Proofs.P3.SInv

noncomputable section

set_option maxHeartbeats 1000000
set_option maxErrors 2000

theorem si_installTcbFrameCap (target : ObjRef) (slot : CslotPtr) (buffer : Option (VSpaceRef × Option (Cap × CslotPtr))) : SIKE (installTcbFrameCap (Z := Unit) target slot buffer) := by
  unfold installTcbFrameCap
  rcases buffer with _ | ⟨ptr, frame⟩
  · exact ike_returnOk _
  · (try dsimp only)
    refine ike_bind (si_capDelete _) fun _ => ?_
    refine ike_bind (ike_liftE (sik_of_sbk fun _ => by sb_auto)) fun _ => ?_
    refine ike_bind (ike_liftE ?_) fun _ => ?_
    · rcases frame with _ | ⟨newCap, srcSlot⟩
      · exact ik_pure _
      · (try dsimp only)
        exact sik_of_sbk fun _ => sb_checkCapAt _ _ _ (sb_checkCapAt _ _ _ (sb_capInsert _ _ _))
    refine ike_bind (ike_liftE (ik_gets _)) fun cur => ?_
    exact ike_liftE (ik_when _ (sik_of_sbk fun _ => by sb_auto))
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_installTcbFrameCap _ _ _)

theorem si_invokeCnode (i : CnodeInvocation) : SIKE (invokeCnode (Z := Unit) i) := by
  cases i with
  | revokeCall d => exact si_capRevoke d
  | deleteCall d => exact si_capDelete d
  | insertCall c s d => exact ike_liftE (sik_of_sbk fun _ => sb_capInsert _ _ _)
  | moveCall c s d => exact ike_liftE (sik_of_sbk fun _ => sb_capMove _ _ _)
  | rotateCall c1 c2 s1 s2 s3 =>
    refine ike_liftE (sik_of_sbk fun _ => ?_)
    exact ik_ite _ (by sb_auto) (ik_bind (sb_capMove _ _ _) fun _ => sb_capMove _ _ _)
  | cancelBadgedSendsCall c =>
    cases c
    all_goals first
      | exact ike_liftE (ik_when _ (sik_of_sbk fun _ => by sb_auto))
      | exact ike_liftE ik_fail
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_invokeCnode _)

theorem si_invokeIrqHandler (a0 : IrqHandlerInvocation) : SIK (invokeIrqHandler (Z := Unit) a0) := by
  cases a0 with
  | aCKIrq irq => exact sik_of_sbk fun _ => by unfold invokeIrqHandler archInvokeIrqHandler; sb_auto
  | setIRQHandler irq cap slot =>
    unfold invokeIrqHandler
    exact ik_bind (ik_gets _) fun _ => ik_bind (si_capDeleteOne _) fun _ => sik_of_sbk fun _ => sb_capInsert _ _ _
  | clearIRQHandler irq =>
    unfold invokeIrqHandler
    exact ik_bind (ik_gets _) fun _ => si_capDeleteOne _
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_invokeIrqHandler _)

theorem si_maybeHandleInterrupt (inKernel : Bool) : SIK (maybeHandleInterrupt (Z := Unit) inKernel) := by
  unfold maybeHandleInterrupt
  refine ik_bind (sik_of_sbk fun _ => by sb_auto) fun irqOpt => ?_
  cases irqOpt with
  | none => exact ik_pure _
  | some irq => exact si_handleInterrupt irq
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_maybeHandleInterrupt _)

/-- `preemption_path`, cases first (its `if sched` is a join point). -/
theorem si_preemptionPath : SIK (preemptionPath (Z := Unit)) := by
  unfold preemptionPath
  have htail : SIK (maybeHandleInterrupt (Z := Unit) true) := si_maybeHandleInterrupt true
  refine ik_bind (ik_gets _) fun ct => ?_
  refine ik_bind (ik_gets _) fun sched => ?_
  cases sched
  · refine ik_bind (ik_gets _) fun csc => ?_
    refine ik_bind (sik_of_sbk fun _ => by sb_auto) fun active => ?_
    cases active
    · first
        | exact ik_bind (sik_of_sbk fun _ => by sb_auto) fun _ => htail
        | exact ik_bind (ik_modify fun _ h => scInv_of_br h (BR.refl _)) fun _ => htail
    · refine ik_bind (ik_gets _) fun _ => ?_
      refine ik_bind (si_chargeBudget _ _) fun _ => ?_
      first | exact htail | exact ik_pure_bind htail
  · refine ik_bind si_checkBudget fun _ => ?_
    first | exact htail | exact ik_pure_bind htail
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_preemptionPath)

end

end Fl4Proofs.P3.SInvB
