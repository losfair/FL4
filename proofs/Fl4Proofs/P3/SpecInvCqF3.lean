/-- One step of `rec_del`, its recursive calls keeping the invariant. -/
theorem q1_recDelF {f : RecDelCall → NonDet (State Unit) (Except Unit (Bool × Cap))}
    (hrec : ∀ k, Q1K (f k)) (k : RecDelCall) : Q1KE (recDelF (Z := Unit) f k) := by
  have hrec' : ∀ k, Q1KE (ε := Unit) (f k : NonDetE (State Unit) Unit (Bool × Cap)) := hrec
  cases k with
  | cTEDeleteCall sl e => unfold recDelF withoutPreemption; q1_auto; all_goals exact hrec' _
  | finaliseSlotCall sl e => unfold recDelF withoutPreemption; q1_auto; all_goals exact hrec' _
  | reduceZombieCall c sl e =>
    unfold recDelF withoutPreemption
    split <;> q1_auto
    all_goals exact hrec' _

theorem q1_recDel (c : RecDelCall) : Q1KE (recDel (Z := Unit) c) := by
  unfold recDel
  exact ik_lfp (fun f hf k => q1_recDelF hf k) c
macro_rules | `(tactic| q1_leaf) => `(tactic| with_reducible exact q1_recDel _)

