macro "oi0_auto" : tactic => `(tactic| repeat' (first
  | ((with_reducible refine ik_doMachineOp ?_ _); oi_side)
  | ((with_reducible refine ik_doExtendedOp ?_ _); oi_side)
  | with_reducible exact ik_getObject _
  | with_reducible exact oi_setObject _ _
