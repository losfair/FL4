/-
P3 (DESIGN.md §9), invariant line G1 (INV-PLAN §4 F5, fo1): **the FPU owner
and the TCB-ness of the owner kept by every spec function that neither writes
the owner nor retypes / detypes** (spec side only, outside the JAtZ cone).

* `TcbAt σ t`: a TCB is at `t`.
* **`OI q σ`**: the FPU owner is `q`, and if `q = some t`, `t` is a TCB.
  `set_object` asserts the old and new objects' `a_type` equal, so a TCB stays
  a TCB under every heap write but `retype_region` / `delete_objects`.
* The family `OIK q m := IK (OI q) m` is sg1's idle-pointer family
  SpecInvSgI1..I6 renamed (`oi_` → `oi_`), with `set_object`'s leaf replaced
  by `oi_setObject`, and the 51 functions reaching an owner write
  (`set_x64_current_fpu_owner`, `switch_local_fpu_owner`, `fpu_release`,
  `lazy_fpu_restore`, `arch_prepare_next_domain`) or a retype / detype removed
  (scratch/fo1/cg.py, untracked): those are SpecInvFoS* (manual).
  Parts 2-6: SpecInvFoG2..G6 (generated by scratch/fo1/tr.py).
-/
import Fl4Proofs.P3.SpecInvNativeScopeT
open Classical

namespace Fl4Proofs.P3.SInvF
open Fl4Spec Fl4Proofs.P3.SInv

noncomputable section

set_option maxHeartbeats 1000000
set_option maxErrors 2000

/-- A TCB is at `t`. -/
def TcbAt (σ : State Unit) (t : ObjRef) : Prop := ∃ x, σ.kheap t = some (.tcb x)

/-- The FPU owner is `q`, and an owner is a TCB. -/
def OI (q : Option ObjRef) (σ : State Unit) : Prop :=
  σ.archState.x64CurrentFpuOwner = q ∧ ∀ t, q = some t → TcbAt σ t

abbrev OIK (q : Option ObjRef) {α : Type} (m : NonDet (State Unit) α) : Prop := IK (OI q) m
abbrev OIKE (q : Option ObjRef) {ε α : Type} (m : NonDetE (State Unit) ε α) : Prop := IKE (OI q) m

variable {Qo : Option ObjRef}

theorem mem_setObjectF {p : ObjRef} {o : KernelObject} {σ : State Unit} {y : Unit × State Unit}
    (h : y ∈ (setObject (Z := Unit) p o σ).1) :
    ∃ k, σ.kheap p = some k ∧ aType k = aType o ∧
      y.2 = { σ with kheap := Function.update σ.kheap p (some o) } := by
  unfold setObject at h
  obtain ⟨⟨y1, y2⟩, hy, hx⟩ := h
  obtain ⟨e1, e2⟩ := mem_getObject hy
  simp only at e1 e2; subst e2
  obtain ⟨z, ⟨hz, rfl⟩, hx⟩ := hx
  obtain ⟨w, hw, hx⟩ := hx
  rw [Set.mem_singleton_iff.1 hw] at hx
  exact ⟨y1, e1, hz, by rw [Set.mem_singleton_iff.1 hx]⟩

/-- A type-preserving heap write keeps TCB-ness everywhere. -/
theorem tcbAt_put {σ : State Unit} {p t : ObjRef} {k o : KernelObject} (hk : σ.kheap p = some k)
    (ht : aType k = aType o) (h : TcbAt σ t) :
    TcbAt { σ with kheap := Function.update σ.kheap p (some o) } t := by
  obtain ⟨x, hx⟩ := h
  show ∃ x, Function.update σ.kheap p (some o) t = some (.tcb x)
  by_cases e : p = t
  · subst e; rw [hx] at hk; cases hk
    cases o <;> simp only [aType] at ht <;> (try split at ht) <;> (try cases ht)
    exact ⟨_, Function.update_self _ _ _⟩
  · exact ⟨x, by rw [Function.update_of_ne (Ne.symm e)]; exact hx⟩

theorem oi_setObject (p : ObjRef) (o : KernelObject) : OIK Qo (setObject (Z := Unit) p o) := by
  intro σ hσ y hy
  obtain ⟨k, hk, ht, e⟩ := mem_setObjectF hy
  rw [e]
  exact ⟨hσ.1, fun t ht' => tcbAt_put hk ht (hσ.2 t ht')⟩

