/-- One step of `rec_del`, its recursive calls keeping the invariant. -/
theorem rt_recDelF {f : RecDelCall → NonDet (State Unit) (Except Unit (Bool × Cap))}
    (hrec : ∀ k, RTK (f k)) (k : RecDelCall) : RTKE (recDelF (Z := Unit) f k) := by
  have hrec' : ∀ k, RTKE (ε := Unit) (f k : NonDetE (State Unit) Unit (Bool × Cap)) := hrec
  cases k with
  | cTEDeleteCall sl e => unfold recDelF withoutPreemption; rt_auto; all_goals exact hrec' _
  | finaliseSlotCall sl e => unfold recDelF withoutPreemption; rt_auto; all_goals exact hrec' _
  | reduceZombieCall c sl e =>
    unfold recDelF withoutPreemption
    split <;> rt_auto
    all_goals exact hrec' _

