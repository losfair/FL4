theorem rt_transferCapsLoop (ep : Option ObjRef) (rb : ObjRef) :
    ∀ (n : Nat) (cs : List (Cap × CslotPtr)) (sl : List CslotPtr) (mi : MessageInfo),
      RTK (transferCapsLoop (Z := Unit) ep rb n cs sl mi)
  | n, [], sl, mi => by unfold transferCapsLoop; rt_auto
  | n, (c, s) :: cs, sl, mi => by
    have ih := fun sl' mi' => rt_transferCapsLoop ep rb (n + 1) cs sl' mi'
    unfold transferCapsLoop
    repeat' (first | exact ih _ _ | (exact ike_liftE (ih _ _)) | rt_leaf | ik_step0 | ik_unfold)
macro_rules | `(tactic| rt_leaf) => `(tactic| with_reducible exact rt_transferCapsLoop _ _ _ _ _ _)

