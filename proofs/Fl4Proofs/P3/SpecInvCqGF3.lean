/-- **`sched_context_unbind_tcb`**: it reschedules before stripping the current thread's SC. -/
theorem rt_schedContextUnbindTcb (scPtr : ObjRef) : RTK (schedContextUnbindTcb (Z := Unit) scPtr) := by
  unfold schedContextUnbindTcb
  refine ik_bind (by rt_auto) fun sc => ?_
  refine ik_bind (ik_assertOpt _) fun tptr => ?_
  refine ik_gets_bind fun σ => ?_
  try dsimp only
  intro hσ y ⟨w, hw, hy⟩
  have hw' : RT w.2 ∧ AC tptr w.2 := by
    unfold NonDet.when at hw
    split at hw
    · exact ⟨rt_rescheduleRequired σ hσ w hw, fun ha => by rw [cn_rescheduleRequired σ w hw] at ha; cases ha⟩
    · rename_i hne
      rw [Set.mem_singleton_iff.1 hw]; exact ⟨hσ, fun _ e => hne e.symm⟩
  obtain ⟨v, hv, hy⟩ := hy
  have hv' := r11_ra (t := tptr) (show RTK (tcbSchedAction (Z := Unit) tcbSchedDequeue tptr) by rt_auto)
    (fun A C => by unfold tcbSchedAction; repeat' (first | ik_step0 | ik_unfold)) w.2 hw' v hv
  obtain ⟨u, hu, hy⟩ := hy
  have hu' := r11_ra (t := tptr) (show RTK (tcbReleaseRemove (Z := Unit) tptr) by rt_auto)
    (fun A C => by unfold tcbReleaseRemove; repeat' (first | ik_step0 | ik_unfold)) v.2 hv' u hu
  obtain ⟨t, ht, hy⟩ := hy
  have ht' := rt_threadSet_ac _ tptr u.2 hu'.2 hu'.1 t ht
  exact (show RTK (setScObjRef (Z := Unit) scTcbUpdate scPtr none) by rt_auto) t.2 ht' y hy
macro_rules | `(tactic| rt_leaf) => `(tactic| with_reducible exact rt_schedContextUnbindTcb _)

