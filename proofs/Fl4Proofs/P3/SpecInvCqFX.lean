/-- The scheduler action, the release queue and the ready queues and the current thread are `A`, `R`, `Q`, `C`. -/
abbrev FX (A : SchedulerAction) (R : List ObjRef) (Q : Domain → Priority → ReadyQueue) (C : ObjRef) (s : State Unit) : Prop :=
  s.schedulerAction = A ∧ s.releaseQueue = R ∧ s.readyQueues = Q ∧ s.curThread = C

abbrev FXK (A : SchedulerAction) (R : List ObjRef) (Q : Domain → Priority → ReadyQueue) (C : ObjRef) {α : Type}
    (m : NonDet (State Unit) α) : Prop := IK (FX A R Q C) m
abbrev FXKE (A : SchedulerAction) (R : List ObjRef) (Q : Domain → Priority → ReadyQueue) (C : ObjRef) {ε α : Type}
    (m : NonDetE (State Unit) ε α) : Prop := IKE (FX A R Q C) m

variable {A : SchedulerAction} {R : List ObjRef} {Q : Domain → Priority → ReadyQueue} {C : ObjRef}

syntax "fx_leaf" : tactic
macro_rules | `(tactic| fx_leaf) => `(tactic| fail "no fx_leaf")
macro_rules | `(tactic| fx_leaf) => `(tactic| ((with_reducible refine ik_doMachineOp ?_ _); exact fun _ _ h => h))
macro_rules | `(tactic| fx_leaf) => `(tactic| ((with_reducible refine ik_doExtendedOp ?_ _); exact fun _ _ h => h))
macro_rules | `(tactic| fx_leaf) => `(tactic| with_reducible exact ik_getObject _)

macro "fx_auto" : tactic => `(tactic| repeat' (first | fx_leaf | ik_step0 | ik_unfold | (unfold NonDetE.whenE) | (unfold NonDetE.unlessE) | (unfold NonDet.when) | (unfold NonDet.unless)))

