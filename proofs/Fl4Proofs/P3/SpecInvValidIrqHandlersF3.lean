theorem hv_fl4Awaken : IKH P (fl4Awaken (Z := Unit)) := by
  intro σ hσ x hx
  obtain ⟨u, s'⟩ := x
  have hx' : fl4TimerFires σ s' := hx
  clear hx
  induction hx' with
  | refl => exact hσ
  | tail _ hst ih =>
    obtain ⟨σ1, h1, rfl⟩ := hst
    rcases h1 with rfl | ⟨n, bd, hs⟩
    · exact WLH.view _ _ (by rfl) (by rfl) ih
    · exact WLH.view _ _ (by rfl) (by rfl) (hv_sendSignal n bd _ ih ((), σ1) (by rw [hs]; exact Set.mem_singleton _))
macro_rules | `(tactic| hv_leaf) => `(tactic| with_reducible exact hv_fl4Awaken)
