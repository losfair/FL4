theorem q4_transferCapsLoop (ep : Option ObjRef) (rb : ObjRef) :
    ∀ (n : Nat) (cs : List (Cap × CslotPtr)) (sl : List CslotPtr) (mi : MessageInfo),
      Q4K (transferCapsLoop (Z := Unit) ep rb n cs sl mi)
  | n, [], sl, mi => by unfold transferCapsLoop; q4_auto
  | n, (c, s) :: cs, sl, mi => by
    have ih := fun sl' mi' => q4_transferCapsLoop ep rb (n + 1) cs sl' mi'
    unfold transferCapsLoop
    repeat' (first | exact ih _ _ | (exact ike_liftE (ih _ _)) | q4_leaf | ik_step0 | ik_unfold)
macro_rules | `(tactic| q4_leaf) => `(tactic| with_reducible exact q4_transferCapsLoop _ _ _ _ _ _)

