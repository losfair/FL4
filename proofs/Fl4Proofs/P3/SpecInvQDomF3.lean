/-- One step of `rec_del`, its recursive calls keeping the invariant. -/
theorem q4_recDelF {f : RecDelCall → NonDet (State Unit) (Except Unit (Bool × Cap))}
    (hrec : ∀ k, Q4K (f k)) (k : RecDelCall) : Q4KE (recDelF (Z := Unit) f k) := by
  have hrec' : ∀ k, Q4KE (ε := Unit) (f k : NonDetE (State Unit) Unit (Bool × Cap)) := hrec
  cases k with
  | cTEDeleteCall sl e => unfold recDelF withoutPreemption; q4_auto; all_goals exact hrec' _
  | finaliseSlotCall sl e => unfold recDelF withoutPreemption; q4_auto; all_goals exact hrec' _
  | reduceZombieCall c sl e =>
    unfold recDelF withoutPreemption
    split <;> q4_auto
    all_goals exact hrec' _

