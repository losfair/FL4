/-
P3 (DESIGN.md §9), invariant line G1 (ft3): **`B` across the budget checks
and the callers of the wake-ups** (spec side only).

* `check_budget` (current thread `c` in `K`, `c ∈ E → c ∈ L`): a `true` result
  is a pure read (the state is unchanged); otherwise `charge_budget` ran and
  `c` leaves `L`. `check_budget_restart` from `B L (c :: E) K` with `c ∈ L`,
  `c ∉ E`: `c`'s exemption ends first (no fault); after a charge a runnable `c`
  has no fault (it is not exempt), so its Restart write is allowed.
* The callers (deletion path, TCB and CNode invocations, interrupts): uniform
  `BK L E K C` lemmas by `b_auto` (generated by proofs/scratch/ft3/gen.py with
  `ONLY=…`, family `BK`; `rec_del` / `cap_revoke` by `ik_lfp`).
-/
import Fl4Proofs.P3.SpecInvFaultTcbsH5
import Fl4Proofs.P3.SpecInvFaultTcbsH6
open Classical

namespace Fl4Proofs.P3.SInv
open Fl4Spec

noncomputable section

set_option maxHeartbeats 1000000

variable {L E K : List ObjRef} {C : ObjRef → Prop}

/-! ## The budget checks -/

theorem b_checkBudget (c : ObjRef) (hcK : c ∈ K) (hcEL : c ∈ E → c ∈ L) {σ : State Unit}
    (hσ : B L E K (· = c) σ) {y : Bool × State Unit} (hy : y ∈ (checkBudget (Z := Unit) σ).1) :
    (y.1 = true → y.2 = σ) ∧ B (L.filter (· ≠ c)) E K (· = c) y.2 := by
  have hfin : B (L.filter (· ≠ c)) E K (· = c) σ :=
    b_mono hσ (fun u hu => (mem_filter_ne hu).1) (fun _ h => h) id
  unfold checkBudget at hy
  obtain ⟨y1, h1, hy⟩ := hy
  rw [mem_gets h1] at hy
  obtain ⟨y2, h2, hy⟩ := hy
  rw [mem_gets h2] at hy
  obtain ⟨y3, h3, hy⟩ := hy
  have e3 : y3.2 = σ := (by repeat' (first | ik_step0 | ik_unfold) :
    IK (fun s => s = σ) (getScRefillSufficient (Z := Unit) _ _)) σ rfl y3 h3
  have hσ3 : B L E K (· = c) y3.2 := by rw [e3]; exact hσ
  (try dsimp only at hy)
  split at hy
  · obtain ⟨y4, h4, hy⟩ := hy
    rw [mem_gets h4] at hy
    rw [Set.mem_singleton_iff.1 hy]
    refine ⟨fun _ => e3, ?_⟩
    show B _ _ _ _ y3.2
    rw [e3]; exact hfin
  · obtain ⟨y4, h4, hy⟩ := hy
    rw [mem_gets h4] at hy
    obtain ⟨y5, h5, hy⟩ := hy
    rw [Set.mem_singleton_iff.1 hy]
    exact ⟨fun h => absurd h (by simp), b_chargeBudget _ true c hcK hcEL _ hσ3 y5 h5⟩

theorem b_checkBudgetRestart (c : ObjRef) (hcL : c ∈ L) (hcK : c ∈ K) (hcE : c ∉ E) {σ : State Unit}
    (hσ : B L (c :: E) K (· = c) σ) {y : Bool × State Unit} (hy : y ∈ (checkBudgetRestart (Z := Unit) σ).1) :
    (y.1 = true → y.2 = σ) ∧ B (L.filter (· ≠ c)) E K (· = c) y.2 := by
  have hσ' : B L E K (· = c) σ := b_dropE hσ fun x hx => Or.inl ((hσ.1.1 c _ hx).2.1 hcL)
  unfold checkBudgetRestart at hy
  obtain ⟨y1, h1, hy⟩ := hy
  obtain ⟨e1, hb1⟩ := b_checkBudget c hcK (fun _ => hcL) hσ' h1
  obtain ⟨y2, h2, hy⟩ := hy
  rw [mem_gets h2] at hy
  obtain ⟨y3, h3, hy⟩ := hy
  obtain ⟨x, hx, rfl⟩ := mem_threadGet h3
  have hc : y1.2.curThread = c := hb1.1.2
  rw [hc] at hx
  (try dsimp only at hy)
  unfold NonDet.when at hy
  split at hy
  · rename_i hcond
    obtain ⟨y4, h4, hy⟩ := hy
    rw [Set.mem_singleton_iff.1 hy]
    refine ⟨fun h => absurd h hcond.1, ?_⟩
    have hxf : x.tcbFault = none := by
      by_contra hf
      rcases (hb1.1.1 c _ hx).1 hf with h | ⟨h, -⟩
      · have := hcond.2; revert h this; cases x.tcbState <;> simp [faultTcbSt, runnable]
      · exact hcE h
    have hb2 : B (c :: L.filter (· ≠ c)) E K (· = c) y1.2 :=
      b_cons hb1 fun z hz => by rw [hx] at hz; cases hz; exact hxf
    have ht : y1.2.curThread ∈ c :: L.filter (· ≠ c) := by rw [hc]; exact List.mem_cons_self ..
    have hb4 := b_setThreadState (L := c :: L.filter (· ≠ c)) (E := E) (K := K) (C := (· = c)) _ .restart
      (Or.inr (Or.inl ht)) (fun _ h => h) (Or.inl fun h => h) (fun _ => Or.inl trivial) y1.2 hb2 y4 h4
    exact b_mono hb4 (fun u hu => List.mem_cons_of_mem _ hu) (fun _ h => h) id
  · obtain ⟨y4, h4, hy⟩ := hy
    rw [Set.mem_singleton_iff.1 h4] at hy
    rw [Set.mem_singleton_iff.1 hy]
    exact ⟨e1, hb1⟩

/-! ## The callers (generated) -/

/-- `b_auto` with the exception-monad `if`/`when` rules first (the plain
`show IK _ (ite …)` rule would drop the `ExceptT.run` of an exception-monad
goal) and failing branches closed at once. -/
macro "b_autoE" : tactic => `(tactic| repeat' (first | b_leaf | (with_reducible exact ik_fail_bind) | b_rd | (with_reducible apply ike_ite) | (with_reducible apply ike_whenE) | (with_reducible apply ike_unlessE) | (with_reducible apply ike_liftE) | (show IK _ (ite _ _ _); split) | (show IK _ (ite _ _ _ >>= _); split) | ik_step0 | ik_unfold | (unfold NonDetE.whenE) | (unfold NonDetE.unlessE) | (unfold NonDet.when) | (unfold NonDet.unless) | (exfalso; contradiction)))

theorem b_fastFinalise (a0 : Cap) (a1 : Bool) : BK L E K C (fastFinalise (Z := Unit) a0 a1) := by
  unfold fastFinalise; b_autoE
macro_rules | `(tactic| b_leaf) => `(tactic| with_reducible exact b_fastFinalise _ _)

