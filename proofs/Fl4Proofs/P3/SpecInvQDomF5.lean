theorem q4_syscall {α β γ : Type} (mFault : FMonad Unit α) (hFault : Fault → SMonad Unit γ) (mError : α → SEMonad Unit β) (hError : SyscallError → SMonad Unit γ) (mFinalise : β → PMonad Unit γ) (h_mFault : Q4KE mFault) (h_hFault : ∀ x0, Q4K (hFault x0)) (h_mError : ∀ x0, Q4KE (mError x0)) (h_hError : ∀ x0, Q4K (hError x0)) (h_mFinalise : ∀ x0, Q4KE (mFinalise x0)) : Q4KE (syscall (Z := Unit) mFault hFault mError hError mFinalise) := by
  unfold syscall; q4_auto
  all_goals first | exact h_mFault | exact h_hFault _ | exact h_mError _ | exact h_hError _ | exact h_mFinalise _
macro_rules | `(tactic| q4_leaf) => `(tactic| with_reducible refine q4_syscall _ _ _ _ _ ?_ (fun _ => ?_) (fun _ => ?_) (fun _ => ?_) (fun _ => ?_))

