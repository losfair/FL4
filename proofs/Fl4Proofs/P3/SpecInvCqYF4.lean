theorem rb_transferCapsLoop (ep : Option ObjRef) (rb : ObjRef) :
    ∀ (n : Nat) (cs : List (Cap × CslotPtr)) (sl : List CslotPtr) (mi : MessageInfo),
      RBK k (transferCapsLoop (Z := Unit) ep rb n cs sl mi)
  | n, [], sl, mi => by unfold transferCapsLoop; rb_auto
  | n, (c, s) :: cs, sl, mi => by
    have ih := fun sl' mi' => rb_transferCapsLoop ep rb (n + 1) cs sl' mi'
    unfold transferCapsLoop
    repeat' (first | exact ih _ _ | (exact ike_liftE (ih _ _)) | rb_leaf | ik_step0 | ik_unfold)
macro_rules | `(tactic| rb_leaf) => `(tactic| with_reducible exact rb_transferCapsLoop _ _ _ _ _ _)

