/-- **`sched_context_donate`**: when the donor is current, `test_reschedule` leaves `resume_cur_thread`. -/
theorem rt_schedContextDonate (scPtr tcbPtr : ObjRef) : RTK (schedContextDonate (Z := Unit) scPtr tcbPtr) := by
  unfold schedContextDonate
  refine ik_bind (by rt_auto) fun fromOpt => ?_
  refine ik_bind ?_ fun _ => by rt_auto
  refine ik_when _ ?_
  refine ik_bind (ik_assertOpt _) fun f => ?_
  intro σ hσ y ⟨v, hv, hy⟩
  have hv1 : RT v.2 := (show RTK (tcbSchedAction (Z := Unit) tcbSchedDequeue f) by rt_auto) σ hσ v hv
  have hv2 : KC σ.schedulerAction σ.curThread v.2 :=
    (show IK (KC σ.schedulerAction σ.curThread) (tcbSchedAction (Z := Unit) tcbSchedDequeue f) by
      unfold tcbSchedAction; repeat' (first | ik_step0 | ik_unfold)) σ ⟨rfl, rfl⟩ v hv
  obtain ⟨u, hu, hy⟩ := hy
  have hu1 : RT u.2 := (show RTK (tcbReleaseRemove (Z := Unit) f) by rt_auto) v.2 hv1 u hu
  have hu2 : KC σ.schedulerAction σ.curThread u.2 :=
    (show IK (KC σ.schedulerAction σ.curThread) (tcbReleaseRemove (Z := Unit) f) by
      unfold tcbReleaseRemove; repeat' (first | ik_step0 | ik_unfold)) v.2 hv2 u hu
  obtain ⟨t, ht, hy⟩ := hy
  have ht2 := kc_threadSet _ _ _ _ u.2 hu2 t ht
  by_cases hA : AC f u.2
  · exact (show RTK (testReschedule (Z := Unit) f) by rt_auto) t.2 (rt_threadSet_ac _ f u.2 hA hu1 t ht) y hy
  · simp only [AC, not_imp, not_not] at hA
    have hf : f = t.2.curThread := by rw [ht2.2, ← hu2.2, hA.2]
    intro hs; rw [cn_testReschedule f t.2 hf y hy] at hs; cases hs
macro_rules | `(tactic| rt_leaf) => `(tactic| with_reducible exact rt_schedContextDonate _ _)

