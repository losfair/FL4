/-- The `if` of `receive_ipc` after the endpoint and notification reads (stated on its literal term). -/
theorem si_recvTail (thread epptr : ObjRef) (isBlocking : Bool) (reply ntfnptr : Option ObjRef)
    (ntfn : Notification) (ep : Endpoint) :
    SIK (if ntfnptr ≠ none ∧ isActive ntfn
      then
        completeSignal (Z := Unit) (the ntfnptr) thread
      else do
        NonDet.when (ntfnptr ≠ none ∧ isBlocking) <| maybeReturnSc (the ntfnptr) thread
        match ep with
        | .sendEP q => do
          NonDet.assert (q ≠ [])
          let sender ← pure (the q.head?)
          tcbEpDequeue sender epptr
          let senderState ← getThreadState sender
          let data ← match senderState with
            | .blockedOnSend _ref data => pure data
            | _ => NonDet.fail
          doIpcTransfer sender (some epptr)
            data.senderBadge data.senderCanGrant
            thread
          let scPtr ← getTcbObjRef Tcb.tcbSchedContext sender
          ifSporadicCurScAssertRefillUnblockCheck scPtr
          let fault ← threadGet Tcb.tcbFault sender
          if data.senderIsCall ∨ fault ≠ none
          then
            if (data.senderCanGrant ∨ data.senderCanGrantReply) ∧ reply ≠ none
            then do
              let senderSc ← getTcbObjRef Tcb.tcbSchedContext sender
              let donate ← pure (decide (senderSc ≠ none ∧ ¬(fault.elim false isTimeoutFault = true)))
              replyPush sender thread (the reply) donate
            else setThreadState sender .inactive
          else do
            setThreadState sender .running
            possibleSwitchTo sender
        | _ => receiveIpcBlocked isBlocking thread epptr reply) := by
  split
  · exact si_completeSignal _ _
  · refine ik_bind (ik_when _ (sik_maybeReturnSc _ _)) fun _ => ?_
    split
    · exact sik_receiveIpc_send _ _ _ _
    · exact sik_of_sbk fun _ => sb_receiveIpcBlocked _ _ _ _

/-- `receive_ipc`, cases first (its `let … ← match` binds are join points). -/
theorem si_receiveIpc (thread : ObjRef) (cap : Cap) (isBlocking : Bool) (replyCap : Cap) :
    SIK (receiveIpc (Z := Unit) thread cap isBlocking replyCap) := by
  have hrest : ∀ (epptr : ObjRef) (reply : Option ObjRef), SIK (do
      let ep ← getEndpoint (Z := Unit) epptr
      let ntfnptr ← getTcbObjRef Tcb.tcbBoundNotification thread
      let ntfn ← match ntfnptr with
        | none => pure defaultNotification
        | some p => getNotification p
      if ntfnptr ≠ none ∧ isActive ntfn
      then
        completeSignal (the ntfnptr) thread
      else do
        NonDet.when (ntfnptr ≠ none ∧ isBlocking) <| maybeReturnSc (the ntfnptr) thread
        match ep with
        | .sendEP q => do
          NonDet.assert (q ≠ [])
          let sender ← pure (the q.head?)
          tcbEpDequeue sender epptr
          let senderState ← getThreadState sender
          let data ← match senderState with
            | .blockedOnSend _ref data => pure data
            | _ => NonDet.fail
          doIpcTransfer sender (some epptr)
            data.senderBadge data.senderCanGrant
            thread
          let scPtr ← getTcbObjRef Tcb.tcbSchedContext sender
          ifSporadicCurScAssertRefillUnblockCheck scPtr
          let fault ← threadGet Tcb.tcbFault sender
          if data.senderIsCall ∨ fault ≠ none
          then
            if (data.senderCanGrant ∨ data.senderCanGrantReply) ∧ reply ≠ none
            then do
              let senderSc ← getTcbObjRef Tcb.tcbSchedContext sender
              let donate ← pure (decide (senderSc ≠ none ∧ ¬(fault.elim false isTimeoutFault = true)))
              replyPush sender thread (the reply) donate
            else setThreadState sender .inactive
          else do
            setThreadState sender .running
            possibleSwitchTo sender
        | _ => receiveIpcBlocked isBlocking thread epptr reply) := by
    intro epptr reply
    refine ik_bind (sik_of_sbk fun _ => by sb_auto) fun ep => ?_
    refine ik_bind (sik_of_sbk fun _ => by sb_auto) fun ntfnptr => ?_
    cases ntfnptr with
    | none =>
      refine ik_bind (ik_pure _) fun ntfn => ?_
      exact si_recvTail thread epptr isBlocking reply none ntfn ep
    | some p =>
      refine ik_bind (sik_of_sbk fun _ => by sb_auto) fun ntfn => ?_
      exact si_recvTail thread epptr isBlocking reply (some p) ntfn ep
  unfold receiveIpc
  cases cap
  case endpointCap epptr bd rights =>
    refine ik_bind (ik_pure _) fun p => ?_
    obtain ⟨epptr', rights'⟩ := p
    cases replyCap
    case replyCap r b =>
      refine ik_bind (sik_of_sbk fun _ => by sb_auto) fun tptr => ?_
      refine ik_bind (ik_when _ (by si_auto)) fun _ => ?_
      first
        | exact hrest epptr' (some r)
        | exact ik_pure_bind (hrest epptr' (some r))
        | exact ik_bind (ik_pure _) fun reply => hrest epptr' reply
    case nullCap =>
      exact ik_bind (ik_pure _) fun reply => hrest epptr' reply
    all_goals (intro σ _ x hx; obtain ⟨_, h, -⟩ := hx; exact h.elim)
  all_goals (intro σ _ x hx; obtain ⟨_, h, -⟩ := hx; exact h.elim)
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_receiveIpc _ _ _ _)

