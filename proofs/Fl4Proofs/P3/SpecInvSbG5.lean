/-- `handle_recv`, by hand (its body is one join point: no automation over it). -/
theorem si_handleRecv (isBlocking canReply : Bool) : SIK (handleRecv (Z := Unit) isBlocking canReply) := by
  unfold handleRecv
  refine ik_bind (ik_gets _) fun thread => ?_
  refine ik_bind (ik_liftM _ (sik_of_sbk fun _ => sb_asUser _ _)) fun epCptr => ?_
  refine ik_catch ?_ fun e => si_handleFault _ _
  (try dsimp only)
  refine ike_bind (sike_of_sbke fun _ => by sb_auto) fun epCap => ?_
  (try dsimp only)
  split
  · (try dsimp only)
    split
    · (try dsimp only)
      split
      · exact ike_bind (sike_of_sbke fun _ => by sb_auto) fun _ => ike_liftE (si_receiveIpc _ _ _ _)
      · exact ike_bind (ike_returnOk _) fun _ => ike_liftE (si_receiveIpc _ _ _ _)
    · exact ike_throw _
  · (try dsimp only)
    split
    · refine ike_bind (ike_liftE (sik_of_sbk fun _ => by sb_auto)) fun bt => ?_
      (try dsimp only)
      split
      · exact ike_liftE (si_receiveSignal _ _ _)
      · exact ike_throw _
    · exact ike_throw _
  · exact ike_throw _
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_handleRecv _ _)

