/-- `install_tcb_cap` by hand (`check_cap_at`'s body is an `SBK` frame: si_auto would unfold it). -/
theorem si_installTcbCap (target : ObjRef) (slot : CslotPtr) (n : Nat) (slotOpt : Option (Cap × CslotPtr)) :
    SIKE (installTcbCap (Z := Unit) target slot n slotOpt) := by
  unfold installTcbCap
  rcases slotOpt with _ | ⟨newCap, srcSlot⟩
  · exact ike_returnOk _
  · (try dsimp only)
    refine ike_bind (si_capDelete _) fun _ => ?_
    refine ike_unlessE _ (ike_liftE ?_)
    exact sik_of_sbk fun _ => sb_checkCapAt _ _ _ (sb_checkCapAt _ _ _ (sb_capInsert _ _ _))
macro_rules | `(tactic| si_leaf) => `(tactic| with_reducible exact si_installTcbCap _ _ _ _)
