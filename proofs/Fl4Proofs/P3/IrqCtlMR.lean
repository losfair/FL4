  have g1 : (y0.bv :: y1.bv :: y2.bv :: y3.bv :: y4.bv :: y5.bv :: y6.bv :: y7.bv :: rest.map UScalar.bv)[1]? = some y1.bv := rfl
  have g5 : (y0.bv :: y1.bv :: y2.bv :: y3.bv :: y4.bv :: y5.bv :: y6.bv :: y7.bv :: rest.map UScalar.bv)[5]? = some y5.bv := rfl
