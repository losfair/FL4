  simp only [bind_ok, core.result.Result.Insts.CoreOpsTry.branch, uncurry_apply_pair]
  obtain ⟨ms', hums, hms'⟩ := doMachineOp_lift_ex
    (Fl4Spec.ioapicMapPinToVectorRemappedImpl y2.bv y3.bv y4.bv y5.bv
      (Fl4Spec.ucast 64 (BitVec.ofNat 8 z.val) + Fl4Spec.irqIntOffset) y7.bv) σ1
  let σa : Fl4Spec.State Unit := { σ1 with machineState := ms' }
  let irqSt : Fl4Spec.X64IRQState := .irqIOAPIC (y2.bv &&& Fl4Spec.mask 5) (y3.bv &&& Fl4Spec.mask 5)
    (y4.bv &&& 1) (y5.bv &&& 1) true
  let σb : Fl4Spec.State Unit := { σa with archState := { σa.archState with
    x64IrqState := Function.update σa.archState.x64IrqState (BitVec.ofNat 8 z.val) irqSt } }
  refine WP.spec_bind (WP.spec_and (WP.spec_and (ctl_finish arI th hP s σ G ⟨hR, hV, hM, hC, hI⟩ hL hHA hFI hFR hAR.mask z hz128 hact0 hps hls hsrcC
    dsl pd hpd1 hpd hdst (DestLive.of_cnRef hpdr ⟨x0, hx0s, capV_of_capAt hc0⟩) s1 σ1 hkb hS hCR1 hIR1 hw (ksub_of_eq (setThreadState_nks _ _) hst) a1 σb rfl rfl rfl rfl rfl)
    (ctl_dk4_at arI th hP s s1 hkb hS hL hCR1.2.2.1 hAR.mask z hz128 hps hls hsrcC dsl pd hpd1 hpd a1))
    (invoke_mrM (L := L) arI hMk hRa1 hz126)) ?_
  rintro ⟨s2, a2⟩ ⟨⟨⟨σ', G', hmem, hCR', hIR', hFI', hHA', hFR', hstp2⟩, hdk2⟩, hmr⟩
  apply (WP.spec_ok (core.result.Result.Ok (), s2, a2)).mpr
  refine ⟨.ioapicRemapped (BitVec.ofNat 8 z.val) dsl (ps.bv, idxs) y2.bv y3.bv y4.bv y5.bv
      (Fl4Spec.ucast 64 (BitVec.ofNat 8 z.val) + Fl4Spec.irqIntOffset) y7.bv, rfl, σ1, hst, σ', G', ?_, ?_, hCR', hIR', hFI', hHA', hFR',
      fun hD => (hdk1 hD).trans (hdk2 (hD.toK.same (hdk1 hD).1)),
      fun hC => ((((Steps.arch arI (s := s) (σ := σ) (Or.inr (Or.inr (Or.inr (Or.inl ⟨_, _, _, _, _, _, _, hmap⟩))))).trans arI (hstp1 hC)).trans arI
        (Steps.ksSpec arI (s := s1) (a := a1) (⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, hums, rfl, rfl, rfl, rfl⟩ : KsStep σ1 σa) rfl rfl (fun h => ⟨h.st, h.node⟩) id)).trans arI
        (Steps.ksSpec arI (s := s1) (a := a1) (σ := σa) (σ' := σb) (by constructor <;> rfl) rfl rfl (fun h => ⟨h.st, h.node⟩) id)).trans arI hstp2⟩
  refine mem_liftE (x := ((), σ')) ?_
  refine mem_bind_nd (x := ((), σa)) hms' ?_
  refine mem_bind_nd (x := (irqSt, σa)) rfl ?_
  refine mem_bind_nd (x := ((), σb)) (updateIrqState_mem _ _ _) ?_
  exact hmem
  exact ctl_mr_close hfr hmr hmem ((mF_lift hms').trans (mF_restart (σ1 := σ1) hst))

/-- **Any other IRQControl label**: `IllegalOperation`. -/
theorem irq_ctl_other_refinesM (th : TypedHeap) (s : S) (ar : A) (σ : Fl4Spec.State Unit)
    (lbl : U64) (h1 : lbl.val ≠ 33) (h2 : lbl.val ≠ 70) (h3 : lbl.val ≠ 71) (h4 : lbl.val ≠ 72)
    (slbl : Fl4Spec.Data) (hlbl : Fl4Spec.genInvocationType slbl ≠ .irqIssueIRQHandler ∧
      Fl4Spec.invocationType slbl ≠ .archInvocationLabel .x64IRQIssueIRQHandlerIOAPIC ∧
      Fl4Spec.invocationType slbl ≠ .archInvocationLabel .x64IRQIssueIRQHandlerMSI)
    (length src buf : U64) (extra : Aeneas.Std.Array obj.Slot 3#usize) (args : List Fl4Spec.Data)
    (ssl : Fl4Spec.CslotPtr) (excaps : List Fl4Spec.Cap) :
    interrupt.decode_irq_control st arI s ar lbl length src buf extra ⦃ res =>
      CPostM (L := L) arI MR Fl4Spec.invokeFl4IrqControl th (L.ksb s) σ
        (Fl4Spec.decodeFl4IrqControl false slbl args ssl excaps) s ar res ⦄ := by
  unfold interrupt.decode_irq_control
  have n1 : ¬ lbl = fl4_abi.label.IRQIssueIRQHandler := by rw [u64_eq_iff]; simpa using h1
  have n2 : (lbl != fl4_abi.label.X86IRQIssueIRQHandlerIOAPIC) = true := by
    rw [bne_iff_ne, ne_eq, u64_eq_iff]; simpa using h2
  have n3 : (lbl != fl4_abi.label.X86IRQIssueIRQHandlerMSI) = true := by
    rw [bne_iff_ne, ne_eq, u64_eq_iff]; simpa using h3
  have n4 : ¬ lbl = fl4_abi.label.X86IRQIssueIRQHandlerIOAPICRemapped := by rw [u64_eq_iff]; simpa using h4
  rw [if_neg n1, if_pos n2, if_pos n3, if_neg n4]
  simp only [error.illegal, bind_ok]
  unfold Fl4Spec.decodeFl4IrqControl
  simp only [Bool.false_eq_true, ↓reduceIte]
  refine CPostM.liftME' ?_
  unfold Fl4Spec.decodeIrqControlInvocationWith
  rw [if_neg hlbl.1]
  refine CPostM.liftME' ?_
  unfold Fl4Spec.archDecodeIrqControlInvocation
  rw [if_neg hlbl.2.1, if_neg hlbl.2.2]
  exact CPostM.err (e := .Sys .IllegalOperation) (e' := .illegalOperation) rfl (Or.inl trivial)

/-- **`decode_irq_control`, every label.** -/
theorem irq_control_decode_refinesM (th : TypedHeap) (hP : Placed th) (s : S) (ar : A) (σ : Fl4Spec.State Unit)
    (G : MdbGhost)
    (hCR : CRel th (L.mem s) σ G) (hL : IntLayout th (L.ksb s)) (hIR : IrqRel (L.mem s) (L.ksb s) σ)
    (hHA : HandlersActive (L.mem s) (L.ksb s) G) (hFI : FinInv th (L.mem s) σ G) (hFR : MdbOKV (L.ksb s) (L.mem s) G)
    (lbl : U64) (slbl : Fl4Spec.Data) (hlbl : IrqCLabel lbl slbl)
    (length buf ct : U64) (hct : sched.cur_thread st s = ok ct) (args : List U64)
    (hlen : length.val = args.length)
    (hargs : ∀ (i : U64) x, args[i.val]? = some x → msg.syscall_arg st s ct buf i = ok x)
    (hcur : σ.curThread = ct.bv) (htcb : th ct = some .tcb)
    (hact : OutsideObjects th (L.nodeAt s (L.cpu s) layout.node.SCHED_ACTION))
    (hact2 : ∀ i : U64, i.val < 128 → L.nodeAt s (L.cpu s) layout.node.SCHED_ACTION ≠ irqStA (L.ksb s) i)
    (extra : Aeneas.Std.Array obj.Slot 3#usize) (x0 : U64) (hx0 : Aeneas.Std.Array.index_usize extra 0#usize = ok x0)
    (excaps : List Fl4Spec.Cap) (hex : ExtraRel th (L.mem s) x0 excaps)
    {ps : U64} {rs : Nat} (hps : th ps = some (.cnode rs)) {idxs : List Bool} (hls : idxs.length = rs)
    (hsrcC : capAt (L.mem s) (cslotAddr (ps.bv, idxs)) = ok .IrqControl)
    (nA : U64) (hnum : arI.num_ioapics ar = ok nA) (hnA : nA.bv = σ.archState.x64NumIoapics)
    (hmask : ∀ (a : A) (irq : U64) (b : Bool), ∃ a', arI.mask_irq a irq b = ok a')
    (hAR : ArchIrqRel arI ar σ)
    (hMk : MaskMR arI MR) (hfr : FrameMR MR) (hR0 : MR ar σ.machineState) (hIoa : MRKeepIoapic arI MR) :
    interrupt.decode_irq_control st arI s ar lbl length (cslotAddr (ps.bv, idxs)) buf extra ⦃ res =>
      CPostM (L := L) arI MR Fl4Spec.invokeFl4IrqControl th (L.ksb s) σ
        (Fl4Spec.decodeFl4IrqControl (decide (lbl.val = 72)) slbl (args.map UScalar.bv) (ps.bv, idxs) excaps)
        s ar res ⦄ := by
  obtain ⟨l33, l67, l68, lo⟩ := hlbl
  by_cases h33 : lbl.val = 33
  · have e : lbl = fl4_abi.label.IRQIssueIRQHandler :=
      UScalar.eq_of_val_eq (by rw [h33]; simp [fl4_abi.label.IRQIssueIRQHandler])
    subst e
    simp only [h33]
    exact irq_issue_refinesM arI th hP s ar σ G hCR hL hIR hHA hFI hFR slbl (l33 h33) length buf ct hct args hlen hargs
      hcur htcb hact hact2 extra x0 hx0 excaps hex hps hls hsrcC nA hnum hnA hmask hMk hfr hR0
  by_cases h70 : lbl.val = 70
  · have e : lbl = fl4_abi.label.X86IRQIssueIRQHandlerIOAPIC :=
      UScalar.eq_of_val_eq (by rw [h70]; simp [fl4_abi.label.X86IRQIssueIRQHandlerIOAPIC])
    subst e
    simp only [h70]
    exact irq_ioapic_refinesM arI th hP s ar σ G hCR hL hIR hHA hFI hFR slbl (l67 h70) length buf ct hct args hlen hargs
      hcur htcb hact hact2 extra x0 hx0 excaps hex hps hls hsrcC hAR hMk hfr hR0 hIoa
  by_cases h71 : lbl.val = 71
  · have e : lbl = fl4_abi.label.X86IRQIssueIRQHandlerMSI :=
      UScalar.eq_of_val_eq (by rw [h71]; simp [fl4_abi.label.X86IRQIssueIRQHandlerMSI])
    subst e
    simp only [h71]
    exact irq_msi_refinesM arI th hP s ar σ G hCR hL hIR hHA hFI hFR slbl (l68 h71) length buf ct hct args hlen hargs
      hcur htcb hact hact2 extra x0 hx0 excaps hex hps hls hsrcC hmask hMk hfr hR0
  by_cases h72 : lbl.val = 72
  · have e : lbl = fl4_abi.label.X86IRQIssueIRQHandlerIOAPICRemapped :=
      UScalar.eq_of_val_eq (by rw [h72]; simp [fl4_abi.label.X86IRQIssueIRQHandlerIOAPICRemapped])
    subst e
    simp only [h72]
    exact irq_remap_refinesM arI th hP s ar σ G hCR hL hIR hHA hFI hFR slbl length buf ct hct args hlen hargs
      hcur htcb hact hact2 extra x0 hx0 excaps hex hps hls hsrcC hAR hMk hfr hR0 hIoa
  simp only [h72]
  exact irq_ctl_other_refinesM arI th s ar σ lbl h33 h70 h71 h72 slbl (lo h33 h70 h71 h72) length _ buf extra _ _ _

end

