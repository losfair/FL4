/-
P3 (DESIGN.md §9), invariant line G4 (g4h, KENTRY-PLAN g4h): **the IRQ control
cap's decode with `MR` at the chosen outcome** (`CPostM`).

* `CPostM arI MR`: IrqControl's `CPost` with `MR a' σ'.machineState` at the
  spec outcome of a successful invocation (FL4's arch state after it).
* `MRKeepIoapic` [P] (arch only): `ioapic_map` / `ioapic_map_remapped` keep
  `MR` (l4v `ioapicMapPinToVector` is a `machine_op_lift` of the machine's
  opaque rest, outside the four fields `MR` reads; MachFieldFam's
  `mkf_machineOpLift` on the spec side).
* `invoke_mrM` (FL4): `invoke_irq_control` moves `MR` by its one
  `mask_irq irq (IRQ_SIGNAL = IRQ_INACTIVE)` (`MaskMR`, i.e. `MachPlat.mask`), an unmask, so for a line
  `irq < 126` (collapse A, Q: irqfix's IrqFixA re-proofs written back; the callers pass the decode's bound
  `ISA_MAX = 15` / `USER_MAX = 123`: `hirq6`, `hz126`);
  `ctl_mr_close` (spec): an outcome of `setIrqState Signal irq` then
  `capInsert` has the four fields of the line unmasked (`setIrqState_ms`,
  `MachT.mtk_capInsert`).
* Copies (generated by scratch/g4h/genctl.py + ctlfix.py from IrqControl /
  IrqIssue / IrqArch / IrqDecode; bodies as the originals but at the
  invocation, where `invoke_mrM` joins `ctl_finish` / `invoke_ctl_rel` and the
  outcome's `MR` is closed by `ctl_mr_close`): `CPostM.of_run` / `congr` /
  `err` / `liftME` / `liftME'`, `target_tailM`, `issue_tailM`,
  `irq_issue_refinesM`, `irq_msi_refinesM`, `irq_ioapic_refinesM`,
  `irq_remap_refinesM`, `irq_ctl_other_refinesM`,
  **`irq_control_decode_refinesM`** (every label).
-/
import Fl4Proofs.P3.IrqDecode
import Fl4Proofs.P3.MachFieldFamT
import Fl4Proofs.P3.SpecInvValidIrqHandlers
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3
open fl4_core Classical

noncomputable section

section
variable {A C : Type} (arI : machine.Arch A)

/-- **[P] The IOAPIC programming keeps `AR`** (module docstring). -/
structure MRKeepIoapic (AR : A → C → Prop) : Prop where
  map : ∀ a i p l po v c, AR a c → arI.ioapic_map a i p l po v ⦃ r => AR r.2 c ⦄
  mapr : ∀ a i p l po v h c, AR a c → arI.ioapic_map_remapped a i p l po v h ⦃ r => AR r.2 c ⦄

/-- `MachPlat.mask`'s shape (masking any line `< 256`, unmasking below 126; collapse A, Q: irqfix's `MaskMRF`). -/
def MaskMR (MR : A → Fl4Spec.MachineState → Prop) : Prop :=
  ∀ a (w : U64) m ms, MR a ms → w.val < cond m 256 126 → arI.mask_irq a w m ⦃ a' =>
    MR a' { ms with irqMasks := Function.update ms.irqMasks (w.bv.setWidth 8) m } ⦄

end

/-- `MachPlat.frame`'s shape on the four fields. -/
def FrameMR {A : Type} (MR : A → Fl4Spec.MachineState → Prop) : Prop :=
  ∀ a ms ms', MR a ms → MachF.mF ms' = MachF.mF ms → MR a ms'

section
open Fl4Spec

theorem setIrqState_ms {st : IrqState} {i : Irq} {σ : State Unit} {x : Unit × State Unit}
    (hx : x ∈ (setIrqState (Z := Unit) st i σ).1) :
    x.2.machineState = { σ.machineState with irqMasks := Function.update σ.machineState.irqMasks i (decide (st = .irqInactive)) } := by
  unfold setIrqState at hx
  rw [SInvV.sv_bind_modify] at hx
  unfold doMachineOp at hx
  obtain ⟨⟨ms0, s1⟩, h1, ⟨⟨r, ms'⟩, s2⟩, h2, ⟨u, s3⟩, h3, hx⟩ := hx
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Set.mem_singleton_iff.1 h1)
  obtain ⟨hm, e2⟩ := h2
  dsimp only at e2
  subst e2
  obtain ⟨-, rfl⟩ := Prod.mk.inj (Set.mem_singleton_iff.1 hm)
  obtain ⟨-, rfl⟩ := Prod.mk.inj (Set.mem_singleton_iff.1 h3)
  rw [Set.mem_singleton_iff.1 hx]

theorem mF_restart {σ σ1 : State Unit}
    (h : setThreadState (Z := Unit) σ.curThread .restart σ = ({((), σ1)}, False)) :
    MachF.mF σ1.machineState = MachF.mF σ.machineState := by
  have e := congrArg Prod.fst (MachT.mtk_setThreadState' _ _ σ ((), σ1) (by rw [h]; exact Set.mem_singleton _))
  simp only [MachT.msFT, MachF.msF, Prod.mk.injEq] at e
  simp only [MachF.mF, e.1, e.2.1, e.2.2.1, e.2.2.2.1]

theorem mF_lift {f : MachineRestMonad Unit} {σ1 : State Unit} {ms' : MachineState}
    (h : ((), { σ1 with machineState := ms' }) ∈ (doMachineOp (Z := Unit) (machineOpLift f) σ1).1) :
    MachF.mF ms' = MachF.mF σ1.machineState := by
  have e := MachF.mfk_doMachineOp (MachF.mkf_machineOpLift f) σ1 _ h
  simp only [MachF.msF, Prod.mk.injEq] at e
  simp only [MachF.mF, e.1, e.2.1, e.2.2.1, e.2.2.2.1]

/-- **The IRQ control invocation's outcome with `MR`** (module docstring). -/
theorem ctl_mr_close {A : Type} {MR : A → MachineState → Prop} (hfr : FrameMR MR) {a : A} {ms0 : MachineState}
    {z : U64} {c : Cap} {p q : CslotPtr} {σb σ' : State Unit}
    (hmr : MR a { ms0 with irqMasks := Function.update ms0.irqMasks (z.bv.setWidth 8) (decide (interrupt.IRQ_SIGNAL = interrupt.IRQ_INACTIVE)) })
    (hmem : ((), σ') ∈ ((setIrqState (Z := Unit) .irqSignal (BitVec.ofNat 8 z.val) >>= fun _ =>
      capInsert (Z := Unit) c p q) σb).1)
    (hb : MachF.mF σb.machineState = MachF.mF ms0) : MR a σ'.machineState := by
  rw [nd_bind_apply] at hmem
  obtain ⟨y, hy, hσ'⟩ := hmem
  have e1 := congrArg Prod.fst (MachT.mtk_capInsert c p q y.2 _ hσ')
  have e2 := setIrqState_ms hy
  refine hfr _ _ _ hmr ?_
  simp only [MachT.msFT, MachF.msF, Prod.mk.injEq] at e1
  simp only [MachF.mF, Prod.mk.injEq] at hb
  have hw : (z.bv.setWidth 8 : BitVec 8) = BitVec.ofNat 8 z.val := by
    apply BitVec.eq_of_toNat_eq; simp
  have d1 : decide (IrqState.irqSignal = IrqState.irqInactive) = false := by decide
  have d2 : decide (interrupt.IRQ_SIGNAL = interrupt.IRQ_INACTIVE) = false := by
    unfold interrupt.IRQ_SIGNAL interrupt.IRQ_INACTIVE; decide
  simp only [MachF.mF, e1.1, e1.2.1, e1.2.2.1, e1.2.2.2.1, e2, hb.1, hb.2.1, hb.2.2.1, hb.2.2.2, hw, d1, d2]

end

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)
variable {MR : A → Fl4Spec.MachineState → Prop}

theorem sig_inact_false : decide (interrupt.IRQ_SIGNAL = interrupt.IRQ_INACTIVE) = false := by
  unfold interrupt.IRQ_SIGNAL interrupt.IRQ_INACTIVE; decide

/-- **FL4's `invoke_irq_control` with `MR`** (module docstring). -/
theorem invoke_mrM (hMk : MaskMR arI MR) {s : S} {a : A} {irq d src : U64} {ms : Fl4Spec.MachineState}
    (hR : MR a ms) (hirq : irq.val < 126) :
    interrupt.invoke_irq_control st arI s a irq d src ⦃ r =>
      MR r.2 { ms with irqMasks := Function.update ms.irqMasks (irq.bv.setWidth 8) (decide (interrupt.IRQ_SIGNAL = interrupt.IRQ_INACTIVE)) } ⦄ := by
  obtain ⟨a1, ha1, hm1⟩ := spec_exists (hMk a irq (decide (interrupt.IRQ_SIGNAL = interrupt.IRQ_INACTIVE)) ms hR (by rw [sig_inact_false]; exact hirq))
  unfold interrupt.invoke_irq_control
  rw [set_irq_state_eq arI s a _ irq ha1]
  simp only [bind_ok]
  exact WP.spec_bind (P0.cdt.insert.p0 st (L.wr s (irqStA (L.ksb s) irq) interrupt.IRQ_SIGNAL) (.IrqHandler irq) src d
    L.total) fun s2 _ => (WP.spec_ok _).2 hm1

/-- **IRQ control's `CPost` with `MR` at the outcome** (module docstring). -/
def CPostM (MR : A → Fl4Spec.MachineState → Prop) {X : Type} (invk : X → Fl4Spec.PMonad Unit Unit) (th : TypedHeap)
    (kb : U64) (σ : Fl4Spec.State Unit)
    (m : Fl4Spec.SEMonad Unit X) (s : S) (ar : A) : core.result.Result Unit error.Exc × S × A → Prop
  | (.Err e, s', a') => s' = s ∧ (∃ e', m.run σ = ({(.error e', σ)}, False) ∧ ErrRel e e') ∧ a' = ar
  | (.Ok (), s', a') => ∃ inv, m.run σ = ({(.ok inv, σ)}, False) ∧ ∃ σ1,
      Fl4Spec.setThreadState (Z := Unit) σ.curThread .restart σ = ({((), σ1)}, False) ∧
      ∃ σ' G', (.ok (), σ') ∈ ((invk inv).run σ1).1 ∧ MR a' σ'.machineState ∧ CRel th (L.mem s') σ' G' ∧
        IrqRel (L.mem s') kb σ' ∧
        FinInv th (L.mem s') σ' G' ∧ HandlersActive (L.mem s') kb G' ∧ MdbOKV kb (L.mem s') G' ∧
        (DomPlaced (L := L) th s → DK4 (L := L) s s') ∧ (CurRun σ → Steps (L := L) arI th s ar σ s' a' σ')

variable {arI} in
theorem CPostM.of_run {X : Type} {invk : X → Fl4Spec.PMonad Unit Unit} {th : TypedHeap} {kb : U64}
    {σ : Fl4Spec.State Unit} {m m' : Fl4Spec.SEMonad Unit X} (h : m.run σ = m'.run σ) {s : S} {ar : A}
    {res : core.result.Result Unit error.Exc × S × A} (hq : CPostM (L := L) arI MR invk th kb σ m' s ar res) :
    CPostM (L := L) arI MR invk th kb σ m s ar res := by
  obtain ⟨r, s', a'⟩ := res
  cases r with
  | Err e => obtain ⟨h1, ⟨e', h2, h3⟩, h4⟩ := hq; exact ⟨h1, ⟨e', h.trans h2, h3⟩, h4⟩
  | Ok u => obtain ⟨inv, h2, h3⟩ := hq; exact ⟨inv, h.trans h2, h3⟩

variable {arI} in
theorem CPostM.congr {X : Type} {invk : X → Fl4Spec.PMonad Unit Unit} {th : TypedHeap} {kb : U64}
    {σ : Fl4Spec.State Unit} {m m' : Fl4Spec.SEMonad Unit X} (h : m.run σ = m'.run σ) {s : S} {ar : A}
    {prog : Result (core.result.Result Unit error.Exc × S × A)}
    (hp : prog ⦃ res => CPostM (L := L) arI MR invk th kb σ m' s ar res ⦄) :
    prog ⦃ res => CPostM (L := L) arI MR invk th kb σ m s ar res ⦄ :=
  WP.spec_mono hp (fun _ hq => CPostM.of_run h hq)

variable {arI} in
theorem CPostM.err {X : Type} {invk : X → Fl4Spec.PMonad Unit Unit} {th : TypedHeap} {kb : U64}
    {σ : Fl4Spec.State Unit} {m : Fl4Spec.SEMonad Unit X} {s : S} {ar : A} {e : error.Exc} {e' : Fl4Spec.SyscallError}
    (h : m.run σ = ({(.error e', σ)}, False)) (he : ErrRel e e') :
    (ok ((.Err e, s, ar) : core.result.Result Unit error.Exc × S × A)) ⦃ res =>
      CPostM (L := L) arI MR invk th kb σ m s ar res ⦄ := by
  rw [WP.spec_ok]; exact ⟨rfl, ⟨e', h, he⟩, rfl⟩

/-- **The target slot**: `lookup_target_slot` then `ensure_empty_slot`
against the spec's `lookup_target_slot` and `ensure_empty`, for any
continuation. -/
theorem target_tailM {X : Type} (invk : X → Fl4Spec.PMonad Unit Unit) (th : TypedHeap) (kb : U64)
    (s : S) (ar : A) (σ : Fl4Spec.State Unit) (hR : StateRel th (L.mem s) σ) (hV : SlotsValid th (L.mem s))
    (c : capability.Cap) (ac : Fl4Spec.Cap) (hca : CapRel c ac) (hcv : CapValid th c) (idx dep : U64)
    (ks : Fl4Spec.CslotPtr → Fl4Spec.SEMonad Unit X)
    (K : obj.Slot → Result (core.result.Result Unit error.Exc × S × A))
    (hK : ∀ dsl pd, dsl.1 = pd.bv → th pd = some (.cnode dsl.2.length) → CnRef th (L.mem s) c pd →
      capAt (L.mem s) (cslotAddr dsl) = ok .Null →
      K (cslotAddr dsl) ⦃ res => CPostM (L := L) arI MR invk th kb σ (ks dsl) s ar res ⦄) :
    (do
      let r ← cspace.lookup_target_slot st s c idx dep
      let cf ← core.result.Result.Insts.CoreOpsTry.branch r
      match cf with
      | core.ops.control_flow.ControlFlow.Continue val =>
        let r1 ← cdt.ensure_empty_slot st s val
        let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
        match cf1 with
        | core.ops.control_flow.ControlFlow.Continue _ => K val
        | core.ops.control_flow.ControlFlow.Break residual =>
          let r2 ← core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            Unit (core.convert.FromSame error.Exc) residual
          ok (r2, s, ar)
      | core.ops.control_flow.ControlFlow.Break residual =>
        let r1 ← core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Unit (core.convert.FromSame error.Exc) residual
        ok (r1, s, ar)) ⦃ res =>
      CPostM (L := L) arI MR invk th kb σ (Fl4Spec.lookupTargetSlot ac (Fl4Spec.dataToCptr idx.bv) (Fl4Spec.unat dep.bv) >>=
        fun d => Fl4Spec.ensureEmpty d >>= fun _ => ks d) s ar res ⦄ := by
  unfold cspace.lookup_target_slot
  obtain ⟨r1, hr1, e1, he1, hrel1⟩ := spec_exists
    (lookup_slot_for_cnode_op_refines (Z := Unit) th s σ hR hV false c ac hca hcv idx dep)
  rw [hr1]; simp only [bind_ok, core.result.Result.Insts.CoreOpsTry.branch]
  have hlt : (Fl4Spec.lookupTargetSlot (Z := Unit) ac (Fl4Spec.dataToCptr idx.bv) (Fl4Spec.unat dep.bv)).run σ =
      ({(e1, σ)}, False) := he1
  cases r1 with
  | Err e =>
    cases e1 with
    | ok _ => exact hrel1.elim
    | error e' =>
      simp only [core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
        core.convert.FromSame, core.convert.FromSame.from, bind_ok, bind_tc_ok]
      exact CPostM.err (run_bind_error hlt _) (Or.inl hrel1)
  | Ok dest =>
    cases e1 with
    | error _ => exact hrel1.elim
    | ok dsl =>
      obtain ⟨rfl, pd, hpd1, hpd, hpdr⟩ := hrel1
      obtain ⟨cd, ad, hcd, hcad, hgd⟩ := hR.slot_cap (Z := Unit) hpd1 hpd
      unfold cdt.ensure_empty_slot
      simp only [slot_cap_eq, hcd, bind_ok]
      have hee := ensureEmpty_run dsl σ hgd
      refine CPostM.congr (run_bind_ok hlt _) ?_
      by_cases hdn : cd = .Null
      swap
      · rw [cap_is_null_ne hdn]
        simp only [bind_ok, Bool.false_eq_true, ↓reduceIte, core.result.Result.Insts.CoreOpsTry.branch,
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual, core.convert.FromSame,
          core.convert.FromSame.from, bind_tc_ok]
        have : ad ≠ .nullCap := fun h => hdn ((hcad.null_iff).1 h)
        simp only [this, ↓reduceIte] at hee
        exact CPostM.err (run_bind_error hee _) (Or.inl trivial)
      subst hdn
      have hadn : ad = .nullCap := (hcad.null_iff).2 rfl
      simp only [hadn, ↓reduceIte] at hee
      rw [cap_is_null_null]
      simp only [bind_ok, ↓reduceIte, core.result.Result.Insts.CoreOpsTry.branch]
      refine CPostM.congr (run_bind_ok hee _) ?_
      exact hK dsl pd hpd1 hpd hpdr hcd

variable {arI} in
theorem CPostM.liftME {X Y : Type} {f : X → Y} {invk : Y → Fl4Spec.PMonad Unit Unit} {th : TypedHeap} {kb : U64}
    {σ : Fl4Spec.State Unit} {m : Fl4Spec.SEMonad Unit X} {s : S} {ar : A} {res : core.result.Result Unit error.Exc × S × A}
    (hq : CPostM (L := L) arI MR (invk ∘ f) th kb σ m s ar res) :
    CPostM (L := L) arI MR invk th kb σ (Fl4Spec.NonDetE.liftME f m) s ar res := by
  obtain ⟨r, s', a'⟩ := res
  cases r with
  | Err e => obtain ⟨h1, ⟨e', h2, h3⟩, h4⟩ := hq; exact ⟨h1, ⟨e', run_liftME_err h2, h3⟩, h4⟩
  | Ok u => obtain ⟨inv, h2, h3⟩ := hq; exact ⟨f inv, run_liftME_ok h2, h3⟩

variable {arI} in
theorem CPostM.liftME' {X Y : Type} {f : X → Y} {invk : Y → Fl4Spec.PMonad Unit Unit} {th : TypedHeap} {kb : U64}
    {σ : Fl4Spec.State Unit} {m : Fl4Spec.SEMonad Unit X} {s : S} {ar : A}
    {prog : Result (core.result.Result Unit error.Exc × S × A)}
    (hp : prog ⦃ res => CPostM (L := L) arI MR (invk ∘ f) th kb σ m s ar res ⦄) :
    prog ⦃ res => CPostM (L := L) arI MR invk th kb σ (Fl4Spec.NonDetE.liftME f m) s ar res ⦄ :=
  WP.spec_mono hp (fun _ hq => CPostM.liftME hq)



/-- After a successful decode: `set_thread_state Restart` then
`invoke_irq_control`, against the spec's (`invoke_irq_control` of
`IRQControl`), for an inactive IRQ. -/
theorem issue_tailM (th : TypedHeap) (hP : Placed th) (s : S) (ar : A) (σ : Fl4Spec.State Unit) (G : MdbGhost)
    (hCR : CRel th (L.mem s) σ G) (hL : IntLayout th (L.ksb s)) (hIR : IrqRel (L.mem s) (L.ksb s) σ)
    (hHA : HandlersActive (L.mem s) (L.ksb s) G) (hFI : FinInv th (L.mem s) σ G) (hFR : MdbOKV (L.ksb s) (L.mem s) G)
    (hmask : ∀ (a : A) (irq : U64) (b : Bool), ∃ a', arI.mask_irq a irq b = ok a')
    (ct : U64) (hcur : σ.curThread = ct.bv) (htcb : th ct = some .tcb)
    (hact : OutsideObjects th (L.nodeAt s (L.cpu s) layout.node.SCHED_ACTION))
    (hact2 : ∀ i : U64, i.val < 128 → L.nodeAt s (L.cpu s) layout.node.SCHED_ACTION ≠ irqStA (L.ksb s) i)
    (irq : U64) (hirq : irq.val < 128) (hirq6 : irq.val < 126) (hin : L.mem s (irqStA (L.ksb s) irq) = 0#u64)
    {ps : U64} {rs : Nat} (hps : th ps = some (.cnode rs)) {idxs : List Bool} (hls : idxs.length = rs)
    (hsrcC : capAt (L.mem s) (cslotAddr (ps.bv, idxs)) = ok .IrqControl)
    (dsl : Fl4Spec.CslotPtr) (pd : U64) (hpd1 : dsl.1 = pd.bv) (hpd : th pd = some (.cnode dsl.2.length))
    (hdst : capAt (L.mem s) (cslotAddr dsl) = ok .Null) (hDL : DestLive th (L.mem s) (L.ksb s) pd)
    (hMk : MaskMR arI MR) (hfr : FrameMR MR) (hR0 : MR ar σ.machineState) :
    (do
      let s1 ← sched.set_thread_state st s ct sched.TS_RESTART
      let (s2, a1) ← interrupt.invoke_irq_control st arI s1 ar irq (cslotAddr dsl) (cslotAddr (ps.bv, idxs))
      ok (core.result.Result.Ok (), s2, a1)) ⦃ res =>
      CPostM (L := L) arI MR (Fl4Spec.invokeFl4IrqControl ∘ Fl4Spec.Fl4IrqControlInvocation.spec) th (L.ksb s) σ
        (Fl4Spec.NonDetE.returnOk (.irqControl (BitVec.ofNat 8 irq.val) dsl (ps.bv, idxs))) s ar res ⦄ := by
  obtain ⟨da, db⟩ := dsl
  simp only at hpd1 hpd; subst hpd1
  have hrs := restart_irq th hP s σ G hCR hL hIR ct hcur htcb hact hact2
  refine WP.spec_bind (WP.spec_and (WP.spec_and hrs (sts_dk4c hP s htcb sched.TS_RESTART)) (spec_self hrs)) ?_
  rintro s1 ⟨⟨⟨hkb, hS, σ1, hst, hCR1, hIR1, -, -, hw⟩, hdk1⟩, hs1⟩
  obtain ⟨xct, hkct, -⟩ := hCR.1.tcb ct htcb
  have hstp1 : CurRun σ → Steps (L := L) arI th s ar σ s1 ar σ1 := Steps.restart arI hcur hkct htcb hs1 hst
  have hL1 : IntLayout th (L.ksb s1) := by rw [hkb]; exact hL
  have hIR1' : IrqRel (L.mem s1) (L.ksb s1) σ1 := by rw [hkb]; exact hIR1
  have hHA1 : HandlersActive (L.mem s1) (L.ksb s1) G := by
    intro y hy i hi
    rw [hS.capV ((hCR.2.2.1.members y).1 hy).1] at hi
    obtain ⟨h1, h2⟩ := hHA y hy i hi
    rw [hkb, hw i h1]; exact ⟨h1, h2⟩
  have hin1 : L.mem s1 (irqStA (L.ksb s1) irq) = 0#u64 := by rw [hkb, hw irq hirq, hin]
  have hFI1 : FinInv th (L.mem s1) σ1 G := hFI.of_same hCR.2.2.1 hS (ksub_of_eq (setThreadState_nks _ _) hst)
  have hAs : AbsSlot th (ps.bv, idxs) := ⟨ps, rfl, Or.inl (by simpa [hls] using hps)⟩
  have hAd : AbsSlot th (pd.bv, db) := ⟨pd, rfl, Or.inl hpd⟩
  have hsrc1 : capAt (L.mem s1) (cslotAddr (ps.bv, idxs)) = ok .IrqControl := by rw [hS.capAt hAs.isSlot, hsrcC]
  have hdst1 : capAt (L.mem s1) (cslotAddr (pd.bv, db)) = ok .Null := by rw [hS.capAt hAd.isSlot, hdst]
  have hFR1 : MdbOKV (L.ksb s1) (L.mem s1) G := by rw [hkb]; exact MdbOKV.of_same hCR.2.2.1 hS hFR
  refine WP.spec_bind (WP.spec_and (WP.spec_and (invoke_ctl_rel arI th hP s1 ar σ1 G hCR1 hL1 hIR1' hHA1 hFI1 hFR1 hmask irq hirq
    hin1 hps hpd hls rfl hsrc1 hdst1 (hDL.same hS hkb))
    (invoke_ctl_dk4c arI hP s1 ar hL1 hCR1.2.2.1 hmask irq hirq hAs.isSlot hAd.isSlot hsrc1))
    (invoke_mrM (L := L) arI hMk hR0 hirq6)) ?_
