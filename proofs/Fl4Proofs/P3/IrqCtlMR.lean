  apply (WP.spec_ok (core.result.Result.Ok (), s2, a2)).mpr
  refine ⟨.issueIRQHandlerIOAPIC (BitVec.ofNat 8 z.val) dsl (ps.bv, idxs) y2.bv y3.bv y4.bv y5.bv
