syntax "un_leaf" : tactic
macro_rules | `(tactic| un_leaf) => `(tactic| fail "no un_leaf")
macro_rules | `(tactic| un_leaf) => `(tactic| (refine p3_of_uk fun _ => ?_; uk_leaf; done))
macro_rules | `(tactic| un_leaf) => `(tactic| (refine p3e_of_uk fun _ => ?_; uk_leaf; done))
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact p3_capDeleteOne _)
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact p3_recDel_cte _ _)
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact p3_recDel_fin _ _)
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact p3_capDelete _)
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact p3_doNormalTransfer _ _ _ _ _ _ _)
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact p3_installTcbCap _ _ _ _ (by decide))
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact p3_checkCapAt_ins _ _ _ _ _ (by decide))

macro "un_auto" : tactic => `(tactic| repeat' (first | un_leaf | contradiction | ik_step0 | ik_unfold | (unfold NonDetE.whenE) | (unfold NonDetE.unlessE) | (unfold NonDet.when) | (unfold NonDet.unless)))

theorem un_capFaultOnFailure {α : Type} (cptr : ObjRef) (rp : Bool) (m : LFMonad Unit α) (h_m : IKE (P3 N) m) : IKE (P3 N) (capFaultOnFailure (Z := Unit) cptr rp m) := by
  unfold capFaultOnFailure; un_auto
  all_goals first | exact h_m
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible refine un_capFaultOnFailure _ _ _ ?_)

