/-- One step of `cap_revoke`, its recursive calls keeping `P3 N`. -/
theorem un_capRevokeF {f : CslotPtr → NonDet (State Unit) (Except Unit Unit)}
    (hrec : ∀ k, IK (P3 N) (f k)) (sl : CslotPtr) : IKE (P3 N) (capRevokeF (Z := Unit) f sl) := by
  have hrec' : ∀ k, IKE (P3 N) (ε := Unit) (f k : NonDetE (State Unit) Unit Unit) := hrec
  unfold capRevokeF withoutPreemption selectExt
  un_auto
  all_goals exact hrec' _

theorem un_capRevoke (sl : CslotPtr) : IKE (P3 N) (capRevoke (Z := Unit) sl) := by
  unfold capRevoke
  exact ik_lfp (fun f hf k => un_capRevokeF hf k) sl
macro_rules | `(tactic| un_leaf) => `(tactic| with_reducible exact un_capRevoke _)

