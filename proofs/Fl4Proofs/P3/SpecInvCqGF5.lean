/-- **`maybe_return_sc`**: it reschedules after stripping the current thread's SC. -/
theorem rt_maybeReturnSc (ntfnPtr tcbPtr : ObjRef) : RTK (maybeReturnSc (Z := Unit) ntfnPtr tcbPtr) := by
  unfold maybeReturnSc
  refine ik_bind (by rt_auto) fun _ => ?_
  refine ik_bind (by rt_auto) fun _ => ?_
  refine ik_when _ ?_
  refine ik_bind (ik_assertOpt _) fun sc => ?_
  intro σ hσ y ⟨t, ht, hy⟩
  have ht2 := kc_threadSet σ.schedulerAction σ.curThread _ tcbPtr σ ⟨rfl, rfl⟩ t ht
  obtain ⟨u, hu, hy⟩ := hy
  have hu2 : KC σ.schedulerAction σ.curThread u.2 :=
    (show IK (KC σ.schedulerAction σ.curThread) (setScObjRef (Z := Unit) scTcbUpdate sc none) by
      repeat' (first | ik_step0 | ik_unfold)) t.2 ht2 u hu
  obtain ⟨z, hz, hy⟩ := hy
  rw [Set.mem_singleton_iff.1 hz] at hy
  try dsimp only at hy
  by_cases hA : AC tcbPtr σ
  · have ht1 := rt_threadSet_ac _ tcbPtr σ hA hσ t ht
    have hu1 := (show RTK (setScObjRef (Z := Unit) scTcbUpdate sc none) by rt_auto) t.2 ht1 u hu
    exact (ik_when _ (show RTK (rescheduleRequired (Z := Unit)) by rt_auto)) u.2 hu1 y hy
  · simp only [AC, not_imp, not_not] at hA
    unfold NonDet.when at hy
    rw [if_pos (by rw [hu2.2]; exact hA.2.symm)] at hy
    intro hs; rw [cn_rescheduleRequired _ y hy] at hs; cases hs
macro_rules | `(tactic| rt_leaf) => `(tactic| with_reducible exact rt_maybeReturnSc _ _)

