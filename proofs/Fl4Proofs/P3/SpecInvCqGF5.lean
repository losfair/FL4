theorem rt_syscall {α β γ : Type} (mFault : FMonad Unit α) (hFault : Fault → SMonad Unit γ) (mError : α → SEMonad Unit β) (hError : SyscallError → SMonad Unit γ) (mFinalise : β → PMonad Unit γ) (h_mFault : RTKE mFault) (h_hFault : ∀ x0, RTK (hFault x0)) (h_mError : ∀ x0, RTKE (mError x0)) (h_hError : ∀ x0, RTK (hError x0)) (h_mFinalise : ∀ x0, RTKE (mFinalise x0)) : RTKE (syscall (Z := Unit) mFault hFault mError hError mFinalise) := by
  unfold syscall; rt_auto
  all_goals first | exact h_mFault | exact h_hFault _ | exact h_mError _ | exact h_hError _ | exact h_mFinalise _
macro_rules | `(tactic| rt_leaf) => `(tactic| with_reducible refine rt_syscall _ _ _ _ _ ?_ (fun _ => ?_) (fun _ => ?_) (fun _ => ?_) (fun _ => ?_))

