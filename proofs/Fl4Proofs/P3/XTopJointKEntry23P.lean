/-- Thread by the MachPlat installs, as `jPreDecHyp_of18` (given `JPathM`). -/
theorem jPreDecHyp_of18U [Fl4Proofs.P1.PlainStore st] {s : S} {ar : A} {σ : Fl4Spec.State Unit}
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s ar σ) {ct : U64} (hct : sched.cur_thread st s = ok ct)
    (hG : JEntryGlobM (L := L) arI AR Z.th) (hE : JEntryAt (L := L) arI AR Z H Cs s ar σ) (hM : MachPlat arI MR)
    (hKD : MRKeepD arI MR) (hPD : JPreDecHypKM (L := L) arI PreKind18 AR MR Z H Cs D s ar σ ct) :
    JPreDecHypKM (L := L) arI PreKind17 AR MR Z H Cs D s ar σ ct := by
  intro hR hVT hVI lbl length blk call don fp buf extra slbl argsU hlen hargs hbuf hl ci sl hsl c hc hK excaps buffer
    hXO hXN hLb hA5 hN
  have hAs : AbsSlot Z.th sl := by
    obtain ⟨p, hp, hth⟩ := hsl; exact ⟨p, hp, Or.inl hth⟩
  have hPl : Placed Z.th := J.xtop.rel.1
  have hsc : capV (L.mem s) (cslotAddr sl) = c := capV_of_capAt hc
  have hni := hE.ni
  have hLv := hE.live
  cases c
  case Thread p =>
    obtain ⟨hEpt, hN⟩ := hN
    by_cases hn : lbl = fl4_abi.label.TCBSetEPTRoot
    · -- SetEPTRoot [scope] (`JVtxScope`, at `JAtPre`): no installing label, so no preemption (`XCapP.reXP`)
      have hx := hEpt hn
      subst hLb
      obtain ⟨sl', hlbl, -, hd⟩ := tcb_canon lbl
      refine XCapP.reXP (arI := arI) hx fun inv hD => ?_
      rw [specDec_thread p hd] at hD
      have e : lbl.val = fl4_abi.label.TCBSetEPTRoot.val := by rw [hn]
      exact thread_noPre_of hlbl ⟨by rw [e]; simp [fl4_abi.label.TCBSetEPTRoot],
        by rw [e]; simp [fl4_abi.label.TCBSetEPTRoot], by rw [e]; simp [fl4_abi.label.TCBSetEPTRoot],
        by rw [e]; simp [fl4_abi.label.TCBSetEPTRoot], by rw [e]; simp [fl4_abi.label.TCBSetEPTRoot]⟩ inv hD
    have hFr := (hN hn).hFr
    subst hLb
    obtain ⟨sl', hlbl, hext, hd⟩ := tcb_canon lbl
    refine XCapP.lbl_congr arI (specDec_thread p hd) ?_
    have hx0 := exAt_idx0 extra
    have hx1 := exAt_idx1 extra
    have hx2 := exAt_idx2 extra
    have hXc := ExtraOK.xc hPl hXO
    -- the untyped extra caps' children at their abstract names: CRel's
    -- `MdbLinks`/`CdtRel`/`MdbInv.parentAdj` (`noChildren_of_adj`)
    have hnc : NcHyp (st := st) Z.th s σ (exAt extra 0) (exAt extra 1) (exAt extra 2) := by
      obtain ⟨-, -, hM, hC, hI⟩ := J.dstate.1
      intro x _ sl0 hAs0 hx hu
      subst hx
      refine noChildren_of_adj Z.th hPl s σ Z.G hM hC (hI.parentAdj (th := Z.th)) sl0 hAs0
        ((hM.members _).2 ⟨hAs0.isSlot, capV (L.mem s) (cslotAddr sl0), capAt_capV _ _, ?_⟩)
      intro h0; rw [h0] at hu; simp [isUt] at hu
    have hnc0 : ∀ sl0 : Fl4Spec.CslotPtr, AbsSlot Z.th sl0 → exAt extra 0 = cslotAddr sl0 →
        isUt (capV (L.mem s) (exAt extra 0)) = true → NoChildrenRel (st := st) s σ (exAt extra 0) sl0 :=
      fun sl0 hA h hu => hnc _ (by simp) sl0 hA h hu
    have hcapC : exAt extra 1 ≠ 0#u64 → ∀ q b, capV (L.mem s) (exAt extra 1) = .SchedContext q b → q ∈ Z.C := by
      -- the slot `XcRel` names, a slot of a CNode of `Z.th` (`JAtZ.scCtxCap`)
      intro h1 q b hq
      obtain ⟨hz, he⟩ := hXc.2 1 _ rfl
      rcases hee : excaps[1]? with _ | e
      · exact absurd (hz.2 (List.getElem?_eq_none_iff.1 hee)) h1
      · obtain ⟨ex, -, ps, hps, hps1⟩ := he e hee
        have hAs1 : AbsSlot Z.th e.2 := ⟨ps, hps1, Or.inl hps⟩
        rw [ex] at hq
        exact (J.scCtxCap arI hAs1.isSlot (by rw [capAt_capV, hq])).1
    have hidS : ∀ (sl' : Fl4Spec.CslotPtr) q, AbsSlot Z.th sl' → capV (L.mem s) (cslotAddr sl') = .Thread q →
        q ≠ L.idleW s := by
      -- no cap but a frame cap names the idle thread (`SpecGlob.idle`)
      intro sl' q hAs' hsc' e
      obtain ⟨c0, ac0, hc0, hca0, hg0⟩ := J.dstate.1.1.abs_cap hAs'
      rw [capAt_capV, hsc'] at hc0; cases eq_of_ok_eq hc0
      rw [hca0.abs] at hg0
      have ha0 := (getCap_set_iff σ sl'.1 sl'.2 _).1 (congrArg Prod.fst hg0)
      apply hE.sg.idle sl'.1 sl'.2 _ ha0 (by simp [IsPageCap, absCap])
      rw [JAtZ.idleThread_eq arI J, ← e]; simp [absCap, Fl4Spec.objRefs]
    have hpI : p ≠ L.idleW s := hidS sl p hAs hsc
    exact decode_invocation_threadJ_stepM arI s ar σ J hni hG.ari hG.tot hE.flags hE.fnz lbl length p blk call don fp buf extra ct hct sl' hlbl argsU hlen hargs ci sl
      hAs hsc excaps buffer hext hE.stall hn J.cwOut hpI _ _ _ hx0 hx1 hx2 hXc hnc hnc0 hcapC hA5 (getBpHyp_of s ct p)
      (fun h => hFr h _ hx0) hG.ppA.minBudget hidS hbuf hl hG.delParts hE.sg hLv hG.nd hM hKD hG.ppA ⟨hR, hVT, hVI⟩ hE.rd0 hE.ctnq hG.timeAg
  case Untyped p sb fi dev =>
    exact hPD hR hVT hVI lbl length blk call don fp buf extra slbl argsU hlen hargs hbuf hl ci sl hsl _ hc hK
      excaps buffer hXO hXN hLb hA5 hN
  all_goals exact (show False from hK).elim

set_option maxHeartbeats 4000000 in
/-- the VT-x Untyped retype from the scope premise, as `jPreDecHyp_of20` (given `JPathM`). -/
theorem jPreDecHyp_of20U {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs D : Set U64} {s : S} {ar : A}
    {σ : Fl4Spec.State Unit} {ct : U64} (h : JVtxHypMU (L := L) arI AR MR Z H Cs D s ar σ ct) :
    JPreDecHypKM (L := L) arI PreKind18 AR MR Z H Cs D s ar σ ct := by
  intro hR hVT hVI lbl length blk call don fp buf extra slbl argsU hlen hargs hbuf hl ci sl hsl c hc hK excaps buffer
    hXO hXN hLb hA5 hN
  cases c
  case Untyped p sb fi dev =>
    obtain ⟨x, hx, h1, h2⟩ := hK
    exact h hR hVT hVI lbl length blk call don fp buf extra slbl argsU hlen hargs hbuf hl ci sl hsl p sb fi dev hc
      x hx h1 h2 excaps buffer hXO hXN hLb hA5 hN
  all_goals exact (show False from hK).elim

/-- `JUtPath` gives `JUtPathM` (forgets `ret`). -/
theorem JUtPath.toM {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs D : Set U64} {s : S} {ar : A}
    {σ : Fl4Spec.State Unit} {lbl length p sb fi : U64} {blk call don fp : Bool} {buf : U64}
    {extra : Aeneas.Std.Array obj.Slot 3#usize} {slbl : Fl4Spec.Data} {argsU : List U64} {ci : Fl4Spec.CapRef}
    {sl : Fl4Spec.CslotPtr} {excaps : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)} {buffer : Option Fl4Spec.ObjRef}
    {ct : U64}
    (h : JUtPath (L := L) arI AR Z H Cs D s ar σ lbl length p sb fi blk call don fp buf extra slbl argsU ci sl excaps
      buffer ct) :
    JUtPathM (L := L) arI AR Z H Cs D s ar σ lbl length p sb fi blk call don fp buf extra slbl argsU ci sl excaps
      buffer ct where
  fan := h.fan
  vtx := h.vtx
  core0 := h.core0
  bufObj := h.bufObj
  heapH := h.heapH
  vsReach := h.vsReach
  rcb := h.rcb

/-- `JPath` gives `JPathM`. -/
theorem JPathM.of {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs D : Set U64} {s : S} {ar : A}
    {σ : Fl4Spec.State Unit} {lbl length : U64} {blk call don fp : Bool} {buf : U64}
    {extra : Aeneas.Std.Array obj.Slot 3#usize} {slbl : Fl4Spec.Data} {argsU : List U64} {ci : Fl4Spec.CapRef}
    {sl : Fl4Spec.CslotPtr} {excaps : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)} {buffer : Option Fl4Spec.ObjRef}
    {ct : U64} {c : capability.Cap}
    (h : JPath (L := L) arI AR Z H Cs D s ar σ lbl length blk call don fp buf extra slbl argsU ci sl excaps buffer ct c) :
    JPathM (L := L) arI AR Z H Cs D s ar σ lbl length blk call don fp buf extra slbl argsU ci sl excaps buffer ct c := by
  cases c
  case Untyped p sb fi dev =>
    obtain ⟨h1, h2⟩ := h
    exact ⟨h1, fun e => (h2 e).toM⟩
  all_goals exact h

/-- `JPathAt` gives `JPathAtM`: the new path premise is weaker. -/
theorem JPathAt.toM {AR : A → Fl4Spec.Cr3 → Prop} {Z : XSets} {H : P1.Heap} {Cs D : Set U64} {s : S} {ar : A}
    {σ : Fl4Spec.State Unit} {ct : U64} {is_call blocking can_donate first_phase : Bool} {cptr : U64}
    (h : JPathAt (L := L) arI AR Z H Cs D s ar σ ct is_call blocking can_donate first_phase cptr) :
    JPathAtM (L := L) arI AR Z H Cs D s ar σ ct is_call blocking can_donate first_phase cptr :=
  fun info mi buf buffer r2 er argsU h1 h2 h3 h4 h5 h6 h7 sl c e exs h8 h9 h10 h11 h12 =>
    JPathM.of (h info mi buf buffer r2 er argsU h1 h2 h3 h4 h5 h6 h7 sl c e exs h8 h9 h10 h11 h12)

end

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)

/-- **`KDispHypsKV21` with `JPathAtM` and `JVtxHypMU`** (module docstring):
no `JUtPath.ret` [W] in the path premise. -/
structure KDispHypsKV23 (AR : A → Fl4Spec.Cr3 → Prop) (MR : A → Fl4Spec.MachineState → Prop) (Z : XSets)
    (H : P1.Heap) (Cs D : Set U64) (s : S) (a : A) (σ : Fl4Spec.State Unit) (n : I64) (c : Fl4Spec.Syscall) : Prop where
  inv : ∀ ct call bl don, sched.cur_thread st s = ok ct → InvSys n call bl don →
    JEntryGlobM (L := L) arI AR Z.th ∧ JEntryAt (L := L) arI AR Z H Cs s a σ ∧
    JPathAtM (L := L) arI AR Z H Cs D s a σ ct call bl don false (L.mem s (regA ct layout.reg.CAP)) ∧
    JVtxHypMU (L := L) arI AR MR Z H Cs D s a σ ct
  recv : ∀ bl cr, RecvSys n bl cr → (∀ d p, σ.curThread ∉ σ.readyQueues d p) ∧
    (∀ x, σ.kheap σ.curThread = some (.tcb x) → Fl4Spec.validFaultHandler x.tcbFaultHandler)
  mid : ∀ ct rg sr cr, sched.cur_thread st s = ok ct → MidSysR n c rg sr cr →
    JEntryGlobM (L := L) arI AR Z.th ∧ JEntryAt (L := L) arI AR Z H Cs s a σ ∧
    JPathAtM (L := L) arI AR Z H Cs D s a σ ct false false true true (L.mem s (regA ct rg)) ∧
    MidRun.JMidPerfHypQ true (Fl4Spec.toBl (L.mem s (regA ct rg)).bv) σ ∧
    JMidVfhHyp (Fl4Spec.toBl (L.mem s (regA ct rg)).bv) σ ∧
    JMidLeavesHyp13 (L := L) arI AR (Fl4Spec.toBl (L.mem s (regA ct rg)).bv) σ ∧
    JVtxHypMU (L := L) arI AR MR Z H Cs D s a σ ct

variable {arI} {MR : A → Fl4Spec.MachineState → Prop} {AR : A → Fl4Spec.Cr3 → Prop}

/-- **`KDispHypsKV21` gives `KDispHypsKV23`** given the scope premise at
`JPathM` (the path premise by `JPathAt.toM`). -/
theorem KDispHypsKV21.to23 {Z : XSets} {H : P1.Heap} {Cs D : Set U64} {s : S} {a : A} {σ : Fl4Spec.State Unit}
    {n : I64} {c : Fl4Spec.Syscall} (h : KDispHypsKV21 (L := L) arI AR MR Z H Cs D s a σ n c)
    (hV : ∀ ct, sched.cur_thread st s = ok ct → JVtxHypMU (L := L) arI AR MR Z H Cs D s a σ ct) :
    KDispHypsKV23 (L := L) arI AR MR Z H Cs D s a σ n c where
  inv ct call bl don hct hi := by
    obtain ⟨h1, h2, h3, -⟩ := h.inv ct call bl don hct hi
    exact ⟨h1, h2, h3.toM, hV ct hct⟩
  recv := h.recv
  mid ct rg sr cr hct hm := by
    obtain ⟨h1, h2, h3, h4, h5, h6, -⟩ := h.mid ct rg sr cr hct hm
    exact ⟨h1, h2, h3.toM, h4, h5, h6, hV ct hct⟩

/-- **J23P's dispatch premise as `KDispHyps13PU`** at one dispatch state (the
conversions of `KDispHypsKV21.to13P` at `JPathM`). -/
theorem KDispHypsKV23.to13PU [Fl4Proofs.P1.PlainStore st] {Z : XSets} {H : P1.Heap} {Cs Ac : Set U64}
    {Lst : U64 → List U64} {D : Set U64} {s : S} {a : A} {σ σ0 : Fl4Spec.State Unit} {n : I64} {c : Fl4Spec.Syscall}
    (h : KDispHypsKV23 (L := L) arI AR MR Z H Cs D s a σ n c) (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ)
    (hBA : BudgetAt σ0 σ true) (hA : P0.ArchTotal arI) (hnd : Fl4Spec.numDomains = 1) (hM : MachPlat arI MR)
    (hKD : MRKeepD arI MR) (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv)
    (htu : ∀ a v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄) :
    KDispHyps13PU (L := L) arI AR MR Z H Cs D s a σ n c where
  inv ct call bl don hct hi := by
    obtain ⟨h1, h2, h3, h4⟩ := h.inv ct call bl don hct hi
    exact ⟨h1, h2, h3, jPreDecHyp_of14U J hct h1 h2 hM (jPreDecHyp_of17U J hct h1 h2 hM hKD
      (jPreDecHyp_of18U J hct h1 h2 hM hKD (jPreDecHyp_of20U h4)))⟩
  recv := h.recv
  mid ct rg sr cr hct hm := by
    obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := h.mid ct rg sr cr hct hm
    exact ⟨h1, h2, h3, h4, h5, jMidLeavesHyp_of7 hA (jMidLeavesHyp_of8 hA (jMidLeavesHyp_of9 hA
      (jMidLeavesHyp_of10 hA (jMidLeavesHyp_of11 hA hmax htu (jMidLeavesHyp_of12 hA
        (jMidLeavesHyp_of13 hA hmax htu h6)))))),
      jPreDecHyp_of14U J hct h1 h2 hM (jPreDecHyp_of17U J hct h1 h2 hM hKD
        (jPreDecHyp_of18U J hct h1 h2 hM hKD (jPreDecHyp_of20U h7)))⟩
  vmt := hBA.vmt hnd

set_option maxHeartbeats 4000000 in
/-- **The newest top: `kernel_entryJ22P` without `JUtPath.ret`** (module
docstring): `KDispHypsKV23` (path premise `JPathAtM`, scope premise
`JVtxHypMU`) and `KBudgetB`. -/
theorem kernel_entryJ23P [Fl4Proofs.P1.PlainStore st] {Z : XSets} {H : P1.Heap}
    {Cs Ac : Set U64} {Lst : U64 → List U64} {D : Set U64} (s : S) (a : A) (σ : Fl4Spec.State Unit)
    (J : JAtZ (L := L) arI AR Z H Cs Ac Lst D s a σ) (hni : Entered σ)
    (hR : MR a σ.machineState) (hVI : ValidIrqMasks σ) (n : I64) (c : Fl4Spec.Syscall)
    (hn : NativeSys n c)
    (hflag : ∀ ct v, sched.cur_thread st s = ok ct → obj.Tcb.flags st ct (L.wr s (regA ct layout.reg.FAULT_IP) v)
      ⦃ f => (f &&& fl4_abi.consts.tcb_flag.TRAP_SYSCALLS) = 0#u64 ⦄)
    (hB : ∀ x, σ.kheap σ.curThread = some (.tcb x) → KBudgetB arI a (faultIPSt σ σ.curThread x))
    (hK : ∀ σb, BudgetAt σ σb true → ∀ (Z' : XSets) (H' : P1.Heap) (Cs' Ac' : Set U64) (Lst' : U64 → List U64)
      (D' : Set U64) (s' : S) (a' : A), JAtZ (L := L) arI AR Z' H' Cs' Ac' Lst' D' s' a' σb →
        KDispHypsKV23 (L := L) arI AR MR Z' H' Cs' D' s' a' σb n c)
    (hFin : ∀ x ∈ (specFront c σ).1, ∀ (Z' : XSets) (H' : P1.Heap) (Cs' Ac' : Set U64) (Lst' : U64 → List U64)
      (D' : Set U64) (s' : S) (a' : A), JAtZR (L := L) arI AR Z' H' Cs' Ac' Lst' D' s' a' x.2 →
        KFinAtR (L := L) arI AR Z' H' Cs' s' a' x.2)
    (hARI : ARIface arI AR) (hA : P0.ArchTotal arI) (hnd : Fl4Spec.numDomains = 1) (hM : MachPlat arI MR)
    (hKD : MRKeepD arI MR) (hPA : PPPlatA arI AR) (hIA : IrqPlatA arI AR)
    (hmrt : ∀ a, sporadic.max_release_time arI a ⦃ mrt => mrt.bv = Fl4Spec.MAX_RELEASE_TIME ⦄)
    (hmb : ∀ a : A, sporadic.min_budget arI a ⦃ mb => mb.bv = Fl4Spec.MIN_BUDGET ⦄)
    (hNS : ∀ (s : S) (a : A) (σ : Fl4Spec.State Unit), JHoleAt (L := L) arI AR s a σ → NativeScope σ)
    (hNSR : ∀ (Z : XSets) (H : P1.Heap) (Cs Ac : Set U64) (Lst : U64 → List U64) (D : Set U64) (s : S) (a : A)
      (σ : Fl4Spec.State Unit), JAtZR (L := L) arI AR Z H Cs Ac Lst D s a σ → NativeScope σ)
    (hT : TimeAgree arI)
    (hmax : Fl4Spec.maxTicksToUs = core.num.U64.MAX.bv)
    (htu : ∀ a v, arI.ticks_to_us a v ⦃ r => r.bv = Fl4Spec.ticksToUs v.bv ⦄) :
    syscall.handle_syscall_old st arI s a n ⦃ r => KPost (L := L) arI AR c σ r ⦄ :=
  kernel_entryJ13PU s a σ J hni hR hVI n c hn hflag hB
    (fun σb hBA Z' H' Cs' Ac' Lst' D' s' a' J' =>
      (hK σb hBA Z' H' Cs' Ac' Lst' D' s' a' J').to13PU J' hBA hA hnd hM hKD hmax htu)
    hFin hARI hA hnd hM hKD.toK hPA hIA hmrt hmb hNS hNSR hT hmax htu

/-- **The platform premises of `kernel_entryJ23P` are satisfiable** (as
J21P's: `j21P_platform`). -/
theorem j23P_platform :
    MachPlat modelArch modelMR ∧ MRKeepD modelArch modelMR ∧
      ∀ (ms : Fl4Spec.MachineState) (i : Fl4Spec.Irq), gaiLine true ms = some i →
        modelArch.take_pending_irq ms ⦃ r => r.1 ≠ syscall.NO_IRQ ∧ r.1.val = i.toNat ⦄ :=
  j21P_platform

end

end

