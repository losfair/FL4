/-
P3 (p3J gen 35): **the decode leaves of the invoking class for the Reply, Null, Zombie, Notification and Endpoint
caps** (the bodies generated by `scratch/p3J/g35/gen_invleaf.py` from gen 34's `midDecEasy_of`, `midDecReply_ofE`
and gen 35's `midDecEp_of`; this template adds the rest).

* `InvDecStW W`: P3JInvCls's `InvDecSt` with one more antecedent `W cp` on the looked-up cap (P3JMidDecK's
  `MidDecStW` for the invoking class); `invDecSt_of_w`: the two halves of a split among the `KW` caps (on `CKI` the
  looked-up cap is `KW`: `getCap_set_iff`, as `midDecSt_of_w`).
* **`invDecEasy_of`**, **`invDecReply_of`**, **`invDecEp_of`**: the mid leaves' proofs at the invoking class's flags
  (`blocking = bl`, `is_call = call`, `can_donate = don`, `first_phase = false`). None of the three proofs reads the
  flags but the Endpoint one: there the stable send `sendAfterRestartSt` and its footprint `sendIpcProjW` are
  already general in `blk` / `call` / `don` (a donating send's SC side condition by `JAtZ.curScNZ`). The Null /
  Zombie decode answers `InvalidCapability` for any flags; the Notification and Reply decodes (IpcSendTop's
  `decode_notificationDMX`, `decode_replyDMX`) take any flags.
* **`invDecSt_of_rest`**: `InvDecSt` from the three leaves and `InvDecStW` at the remaining `KW` caps
  (`¬ IsReplyCap ∧ ¬ IsEasyCap ∧ ¬ IsEpCap`).
* **`DispStabFootLj` [J]** {invDecRest, midDecRest, midSpec, midRecvSw}: P3JInvCls's `DispStabFootLi` with `invDec`
  restricted to those caps; **`dispStabFootLi_of_Lj`**, top **`kernel_entry_runMcWKR_sysLj`** (globals as `_sysLi`).

Premise honesty: `invDecRest` is `invDec` at a smaller cap predicate (`InvDecStW` is antitone in it, and
`InvDecStW (KW ∧ ·)` is implied by `InvDecSt`), so `DispStabFootLj` is implied by `DispStabFootLi`.

Named premise: `DispStabFootLj` [J]. No sorry. New module; no existing statement changed.
-/
import Fl4Proofs.P3.P3JInvCls
open Aeneas Aeneas.Std Result

namespace Fl4Proofs.P3
open fl4_core Classical Fl4Proofs.P3.Vs Fl4Proofs.P3.Notif Fl4Proofs.P3.Endp Fl4Proofs.P3.Ipc Fl4Proofs.P3.Sched
open Fl4Proofs.P3.SInvR.G4

noncomputable section

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} (arI : machine.Arch A)
variable (AR : A → Fl4Spec.Cr3 → Prop) (MR : A → Fl4Spec.MachineState → Prop)

/-- (p3J gen 35) **`InvDecSt` with one more antecedent on the looked-up cap** (module docstring). -/
def InvDecStW (W : capability.Cap → Prop) (Z : XSets) (H : P1.Heap) (Cs : Set U64) (s : S) (a : A)
    (σ : Fl4Spec.State Unit) (n : I64) (call bl don : Bool) : Prop :=
  ∀ σb, BudgetAt σ σb true → ∀ (V' : XVs) (Ac' : Set U64) (Lst' : U64 → List U64) (D' : Set U64) (s' : S) (a' : A),
    KFrontB (L := L) arI s a s' a' → JAtZ (L := L) arI AR (Z.mv Z.G V') H Cs Ac' Lst' D' s' a' σb →
    MR a' σb.machineState → SInvCk.CKI σb → SInvRr.RR σb →
    ∀ ct, sched.cur_thread st s' = ok ct → InvSys n call bl don →
    ∀ (info : msginfo.MessageInfo) (mi : Fl4Spec.MessageInfo) (buf : U64) (buffer : Option Fl4Spec.ObjRef)
      (r2 : core.result.Result (Aeneas.Std.Array obj.Slot 3#usize) error.Fault)
      (er : Except Fl4Spec.Fault (List (Fl4Spec.Cap × Fl4Spec.CslotPtr))) (argsU : List U64),
      msg.msg_info st s' ct = ok info →
      Fl4Spec.getMessageInfo (Z := Unit) ct.bv σb = ({(mi, σb)}, False) →
      msg.lookup_ipc_buffer st s' false ct = ok buf →
      Fl4Spec.lookupIpcBuffer (Z := Unit) false ct.bv σb = ({(buffer, σb)}, False) →
      ipc.lookup_extra_caps st s' ct buf info = ok r2 →
      (Fl4Spec.lookupExtraCaps (Z := Unit) ct.bv buffer mi).run σb = ({(er, σb)}, False) →
      Fl4Spec.getMrs (Z := Unit) ct.bv buffer mi σb = ({(argsU.map UScalar.bv, σb)}, False) →
      ∀ (sl : Fl4Spec.CslotPtr) (cp : capability.Cap) (e : Aeneas.Std.Array obj.Slot 3#usize)
        (exs : List (Fl4Spec.Cap × Fl4Spec.CslotPtr)), (∃ p, sl.1 = p.bv ∧ Z.th p = some (.cnode sl.2.length)) →
        capAt (L.mem s') (cslotAddr sl) = ok cp → Fl4Spec.getCap (Z := Unit) sl σb = ({(absCap cp, σb)}, False) →
        r2 = .Ok e → er = .ok exs → W cp →
        XCapP (L := L) arI (MidX (L := L) arI AR MR Z H Cs s') (MidXP (L := L) arI AR MR Z H Cs s') s' a' σb
          info.label (msgLen info buf) (cslotAddr sl) cp bl call don false buf e mi.miLabel
          (argsU.map UScalar.bv) (Fl4Spec.toBl (L.mem s' (Endp.regA ct layout.reg.CAP)).bv) sl exs buffer ct

end

section
variable {S : Type} {st : machine.Store S} [L : P1.LawfulStore st] {A : Type} {arI : machine.Arch A}
variable {AR : A → Fl4Spec.Cr3 → Prop} {MR : A → Fl4Spec.MachineState → Prop} {Z : XSets} {H : P1.Heap}
  {Cs Ac : Set U64} {Lst : U64 → List U64} {D : Set U64}

/-- (p3J gen 35) **The two halves of a split on `P` among the `KW` caps give `InvDecSt`** (`midDecSt_of_w`). -/
theorem invDecSt_of_w (P : capability.Cap → Prop) {s : S} {a : A} {σ : Fl4Spec.State Unit} {n : I64}
    {call bl don : Bool}
    (h1 : InvDecStW (L := L) arI AR MR (fun cp => SInvCk.KW (absCap cp) ∧ P cp) Z H Cs s a σ n call bl don)
    (h2 : InvDecStW (L := L) arI AR MR (fun cp => SInvCk.KW (absCap cp) ∧ ¬ P cp) Z H Cs s a σ n call bl don) :
    InvDecSt (L := L) arI AR MR Z H Cs s a σ n call bl don := by
  intro σb hBA V' Ac' Lst' D' s' a' hKF J hMb hCb hRRb ct hct hn info mi buf buffer r2 er argsU
    a1 a2 a3 a4 a5 a6 a7 sl cp e exs hsl hc hget he hexs
  have hK : SInvCk.KW (absCap cp) := by
    obtain ⟨o, i⟩ := sl
    exact hCb o i (absCap cp) ((getCap_set_iff σb o i (absCap cp)).1 (congrArg Prod.fst hget))
  by_cases hP : P cp
  · exact h1 σb hBA V' Ac' Lst' D' s' a' hKF J hMb hCb hRRb ct hct hn info mi buf buffer r2 er argsU
      a1 a2 a3 a4 a5 a6 a7 sl cp e exs hsl hc hget he hexs ⟨hK, hP⟩
  · exact h2 σb hBA V' Ac' Lst' D' s' a' hKF J hMb hCb hRRb ct hct hn info mi buf buffer r2 er argsU
      a1 a2 a3 a4 a5 a6 a7 sl cp e exs hsl hc hget he hexs ⟨hK, hP⟩

